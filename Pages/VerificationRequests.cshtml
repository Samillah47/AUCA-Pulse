@page
@model AUCAPulse.Pages.VerificationRequestsModel
@{
    ViewData["Title"] = "Verification Requests";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Verification Requests</h2>
        <span class="badge bg-warning text-dark fs-6">@Model.Requests.Count Pending</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Requests.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No pending verification requests.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var request in Model.Requests)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0">@request.UserName</h5>
                                <span class="badge bg-warning text-dark">@request.Status</span>
                            </div>
                            <p class="card-text">
                                <strong>Email:</strong> @request.UserEmail<br>
                                <strong>Phone:</strong> @request.UserPhone<br>
                                <strong>Department:</strong> @request.UserDepartment<br>
                                <strong>Role:</strong> <span class="badge bg-secondary">@request.RequestedRole</span><br>
                                <strong>Requested:</strong> @request.RequestedAt.ToString("MMM dd, yyyy HH:mm")
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <form method="post" class="d-inline">
                                <input type="hidden" name="requestId" value="@request.Id" />
                                <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm me-2">
                                    <i class="bi bi-check-circle me-1"></i>Approve
                                </button>
                                <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm">
                                    <i class="bi bi-x-circle me-1"></i>Reject
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
