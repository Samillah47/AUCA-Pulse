@page "/StaffDashboard"
@model AUCAPulse.Pages.StaffDashboardModel
@{ ViewData["Title"] = "Staff Dashboard"; }

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-speedometer2"></i> Staff Dashboard</h2>
            <p class="text-muted small">Welcome, @((Model.StaffUser as dynamic)?.Name ?? "Staff")</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Status Card -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Your Availability</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            @{
                                var status = Model.AvailabilityStatus ?? "AVAILABLE";
                                var badgeClass = status == "AVAILABLE" ? "bg-success" : 
                                                 status == "IN_CLASS" ? "bg-info" :
                                                 status == "IN_MEETING" ? "bg-warning" :
                                                 status == "UNAVAILABLE" ? "bg-danger" :
                                                 "bg-secondary";
                            }
                            <span class="badge @badgeClass" style="font-size: 1rem;">@status</span>
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#statusModal">
                            <i class="bi bi-pencil"></i> Change
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Your Office</h5>
                    @if (Model.Office != null)
                    {
                        <p class="mb-0"><strong>@((Model.Office as dynamic)?.OfficeName)</strong></p>
                        <p class="text-muted small">@((Model.Office as dynamic)?.Building) - @((Model.Office as dynamic)?.OfficeNumber)</p>
                    }
                    else
                    {
                        <p class="text-muted">No office assigned</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm" style="cursor: pointer;" onclick="location.href='/Appointments?status=PENDING';">
                <div class="card-body">
                    <h5 class="card-title">Pending Appointments</h5>
                    <h3 class="fw-bold text-warning">@Model.PendingAppointments.Count</h3>
                    <p class="text-muted small">Requests awaiting your response</p>
                    <small class="text-primary"><i class="bi bi-arrow-right"></i> View pending</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm" style="cursor: pointer;" onclick="location.href='/Appointments?status=APPROVED&filter=upcoming';">
                <div class="card-body">
                    <h5 class="card-title">Approved Upcoming</h5>
                    <h3 class="fw-bold text-success">@Model.ApprovedUpcomingAppointments.Count</h3>
                    <p class="text-muted small">Confirmed appointments coming up</p>
                    <small class="text-primary"><i class="bi bi-arrow-right"></i> View upcoming</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm" style="cursor: pointer;" onclick="location.href='/Appointments';">
                <div class="card-body">
                    <h5 class="card-title">All Appointments</h5>
                    <h3 class="fw-bold text-primary">@Model.AllAppointments.Count</h3>
                    <p class="text-muted small">Total appointment requests</p>
                    <small class="text-primary"><i class="bi bi-arrow-right"></i> View all</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Appointments -->
    @if (Model.PendingAppointments.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Pending Appointment Requests</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Requested Date</th>
                            <th>Reason</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model.PendingAppointments)
                        {
                            <tr>
                                <td><strong>@((apt as dynamic)?.StudentName)</strong></td>
                                <td>@((apt as dynamic)?.AppointmentDate.ToString("MMM dd, yyyy HH:mm"))</td>
                                <td>@((apt as dynamic)?.Reason ?? "N/A")</td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="Approve" style="display: inline;">
                                        <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check"></i> Approve
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject" style="display: inline;">
                                        <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-x"></i> Reject
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Status Change Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Change Availability Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateStatus">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Status</label>
                        <select class="form-select" name="newStatus" id="statusSelect" required>
                            <option value="AVAILABLE">✅ Available - Ready for appointments</option>
                            <option value="IN_CLASS">📚 In Class - Currently teaching</option>
                            <option value="IN_MEETING">💼 In Meeting - Currently in a meeting</option>
                            <option value="AWAY">🚫 Away - Not available</option>
                            <option value="UNAVAILABLE">🔒 Unavailable - Not accessible</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card { border: none; border-radius: 0.5rem; }
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .badge { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Set the current status in the select dropdown
        var currentStatus = "@Model.AvailabilityStatus";
        var selectElement = document.getElementById('statusSelect');
        if (selectElement && currentStatus) {
            selectElement.value = currentStatus;
        }
    });
</script>
