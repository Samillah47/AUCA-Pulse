@page "/StaffDashboard"
@model AUCAPulse.Pages.StaffDashboardModel
@{
    ViewData["Title"] = "Staff Dashboard";
    var today = DateTime.Now.ToString("dddd, d MMMM yyyy");
    var greetHour = DateTime.Now.Hour;
    var greetWord = greetHour < 12 ? "Good morning" : (greetHour < 18 ? "Good afternoon" : "Good evening");
    var staffName = (Model.StaffUser as dynamic)?.Name ?? "Staff";
    var status = Model.AvailabilityStatus ?? "AVAILABLE";
    var statusBadgeClass = status switch
    {
        "AVAILABLE"   => "bg-success",
        "IN_CLASS"    => "bg-info",
        "IN_MEETING"  => "bg-warning",
        "AWAY"        => "bg-secondary",
        "UNAVAILABLE" => "bg-danger",
        _             => "bg-secondary"
    };
}

<!-- Hero greeting (unified with admin/lecturer dashboard) -->
<div class="dash-hero mb-4">
    <div>
        <div class="dash-hero-date">@today</div>
        <h1 class="dash-hero-title">@greetWord, @staffName</h1>
        <div class="dash-hero-sub">
            <i class="bi bi-person-badge me-1"></i>Staff member
            <span class="mx-2">·</span>
            <span class="badge @statusBadgeClass">
                <i class="bi bi-circle-fill me-1" style="font-size:7px;"></i>@status.Replace('_', ' ')
            </span>
            @if (Model.Office != null)
            {
                <span class="mx-2">·</span>
                <span><i class="bi bi-building me-1"></i>@((Model.Office as dynamic)?.OfficeName) · @((Model.Office as dynamic)?.OfficeNumber)</span>
            }
        </div>
    </div>
    <div class="dash-hero-art" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="72" height="72" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="16" width="48" height="40" rx="4" />
            <path d="M8 26h48" />
            <path d="M22 16V8h20v8" />
            <circle cx="32" cy="41" r="5" />
        </svg>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI row -->
<div class="row g-3 mb-4 stagger">
    <div class="col-6 col-md-3">
        <a href="/Appointments?status=PENDING" class="kpi-card text-decoration-none text-reset">
            <div class="kpi-icon" style="background:#fffbeb;color:#f59e0b;"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="kpi-value">@Model.PendingAppointments.Count</div>
                <div class="kpi-label">Pending requests</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Appointments?status=APPROVED&filter=upcoming" class="kpi-card text-decoration-none text-reset">
            <div class="kpi-icon" style="background:#ecfdf5;color:#10b981;"><i class="bi bi-calendar-check"></i></div>
            <div>
                <div class="kpi-value">@Model.ApprovedUpcomingAppointments.Count</div>
                <div class="kpi-label">Approved upcoming</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Appointments" class="kpi-card text-decoration-none text-reset">
            <div class="kpi-icon" style="background:#eff6ff;color:#2563eb;"><i class="bi bi-collection"></i></div>
            <div>
                <div class="kpi-value">@Model.AllAppointments.Count</div>
                <div class="kpi-label">All appointments</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <button type="button" class="kpi-card w-100 border-0" data-bs-toggle="modal" data-bs-target="#statusModal" style="cursor:pointer;background:var(--surface);">
            <div class="kpi-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="bi bi-broadcast"></i></div>
            <div class="text-start">
                <div class="kpi-value" style="font-size:1.05rem;line-height:1.3;">@status.Replace('_', ' ')</div>
                <div class="kpi-label">My status — tap to change</div>
            </div>
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- My Office -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-building me-2"></i>My Office</h5>
            </div>
            <div class="card-body">
                @if (Model.Office != null)
                {
                    <div class="d-flex align-items-start gap-3">
                        <div style="width:44px;height:44px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;">
                            <i class="bi bi-door-open fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@((Model.Office as dynamic)?.OfficeName)</div>
                            <div class="text-muted small">
                                <i class="bi bi-geo-alt me-1"></i>@((Model.Office as dynamic)?.Building) · Room @((Model.Office as dynamic)?.OfficeNumber)
                            </div>
                        </div>
                    </div>
                    <a href="/MyOffice" class="btn btn-primary mt-3">
                        <i class="bi bi-pencil-square me-1"></i>Manage my office
                    </a>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-building-x"></i>
                        <h5>No office assigned yet</h5>
                        <div>Ask an admin to assign you an office.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-lightning-charge me-2"></i>Quick actions</h5>
            </div>
            <div class="card-body d-grid gap-2">
                <a href="/Appointments" class="btn btn-outline-primary text-start">
                    <i class="bi bi-calendar-check me-2"></i>Review appointments
                </a>
                <a href="/UpdateStatus" class="btn btn-outline-primary text-start">
                    <i class="bi bi-broadcast me-2"></i>Update my status
                </a>
                <a href="/Rooms" class="btn btn-outline-primary text-start">
                    <i class="bi bi-door-open me-2"></i>Find a free room
                </a>
                <a href="/Lecturers" class="btn btn-outline-primary text-start">
                    <i class="bi bi-people me-2"></i>Browse lecturers
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Pending appointments -->
@if (Model.PendingAppointments.Count > 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-hourglass-split me-2"></i>Pending appointment requests</h5>
            <span class="badge bg-warning">@Model.PendingAppointments.Count waiting</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Requested date</th>
                            <th>Reason</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model.PendingAppointments)
                        {
                            <tr>
                                <td><strong>@((apt as dynamic)?.StudentName)</strong></td>
                                <td>@((apt as dynamic)?.AppointmentDate.ToString("MMM dd, yyyy HH:mm"))</td>
                                <td class="text-muted">@((apt as dynamic)?.Reason ?? "—")</td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="Approve" class="d-inline">
                                        <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject" class="d-inline ms-1">
                                        <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-lg"></i> Reject
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="empty-state py-4">
                <i class="bi bi-inbox"></i>
                <h5>All caught up</h5>
                <div>No pending appointment requests right now.</div>
            </div>
        </div>
    </div>
}

<!-- Status Change Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-broadcast text-primary me-2"></i>Change availability status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateStatus">
                <div class="modal-body">
                    <label class="form-label">Select status</label>
                    <select class="form-select" name="newStatus" id="statusSelect" required>
                        <option value="AVAILABLE">Available — Ready for appointments</option>
                        <option value="IN_MEETING">In Meeting — Currently in a meeting</option>
                        <option value="AWAY">Away — Not available</option>
                        <option value="UNAVAILABLE">Unavailable — Not accessible</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Update status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var currentStatus = "@Model.AvailabilityStatus";
            var select = document.getElementById('statusSelect');
            if (select && currentStatus) {
                select.value = currentStatus;
            }
        });
    </script>
}
