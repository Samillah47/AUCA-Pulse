@page
@model AUCAPulse.Pages.CancelledClassesModel
@{
    ViewData["Title"] = "Cancelled Classes";
    var isToday = Model.EffectiveDate == DateTime.UtcNow.Date;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="display-6 mb-1">Cancelled Classes</h1>
            <p class="text-muted mb-0">
                Classes the lecturer has marked as not running
                @(isToday ? "today" : $"on {Model.EffectiveDate:MMM d, yyyy}").
                The room was released automatically when cancelled.
            </p>
        </div>
        <form method="get" class="d-flex align-items-end gap-2">
            <div>
                <label for="dateInput" class="form-label small text-muted mb-1">Date</label>
                <input type="date" id="dateInput" name="Date" class="form-control form-control-sm"
                       value="@Model.EffectiveDate.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-funnel me-1"></i>Filter
            </button>
            @if (!isToday)
            {
                <a href="/CancelledClasses" class="btn btn-outline-secondary btn-sm">Today</a>
            }
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div style="width:44px;height:44px;border-radius:10px;background:#fee2e2;color:#b91c1c;display:grid;place-items:center;">
                        <i class="bi bi-x-octagon fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Cancelled</div>
                        <div class="fs-4 fw-semibold">@Model.Items.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div style="width:44px;height:44px;border-radius:10px;background:#dbeafe;color:#1d4ed8;display:grid;place-items:center;">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Lecturers affected</div>
                        <div class="fs-4 fw-semibold">@Model.Items.Select(i => i.LecturerId).Distinct().Count()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div style="width:44px;height:44px;border-radius:10px;background:#dcfce7;color:#15803d;display:grid;place-items:center;">
                        <i class="bi bi-door-open fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Rooms released</div>
                        <div class="fs-4 fw-semibold">@Model.Items.Where(i => !string.IsNullOrWhiteSpace(i.RoomNumber)).Select(i => i.RoomNumber).Distinct().Count()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Details</h5>
            <small class="text-muted">Showing @Model.Items.Count result@(Model.Items.Count == 1 ? "" : "s")</small>
        </div>
        <div class="card-body">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle display-1 text-success"></i>
                    <h5 class="mt-3">No cancellations @(isToday ? "today" : "on this date")</h5>
                    <p class="text-muted mb-0">All scheduled classes are running as planned.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" data-paginate="10">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Course</th>
                                <th>Lecturer</th>
                                <th>Room</th>
                                <th>Group</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @row.StartTime.Substring(0, Math.Min(5, row.StartTime.Length))
                                            -
                                            @row.EndTime.Substring(0, Math.Min(5, row.EndTime.Length))
                                        </span>
                                        <div class="text-muted small">@row.DayOfWeek</div>
                                    </td>
                                    <td>
                                        <strong>@row.CourseCode</strong>
                                        @if (!string.IsNullOrWhiteSpace(row.CourseName))
                                        {
                                            <div class="text-muted small">@row.CourseName</div>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Lecturers/@row.LecturerId" class="text-decoration-none">
                                            @row.LecturerName
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.RoomNumber))
                                        {
                                            <span class="badge bg-secondary">@row.RoomNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.GroupName))
                                        {
                                            <span class="badge bg-primary">Group @row.GroupName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(row.CancellationReason))
                                        {
                                            <span class="text-muted"><em>@row.CancellationReason</em></span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No reason given</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
