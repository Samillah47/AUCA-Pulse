@page
@model AUCAPulse.Pages.LecturersModel
@{
    ViewData["Title"] = "Lecturers";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6">Find Lecturers</h1>
            <p class="text-muted">Search for lecturers and check their availability</p>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="search" class="form-control form-control-lg" placeholder="Search by name, email, or department..." value="@Model.SearchQuery" />
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-search"></i> Search
                </button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- Lecturers Grid -->
    <div class="row g-4">
        @if (Model.Lecturers != null && Model.Lecturers.Any())
        {
            @foreach (var lecturer in Model.Lecturers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-start mb-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                    <i class="bi bi-person fs-3 text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">@lecturer.Name</h5>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-envelope me-1"></i>@lecturer.Email
                                    </p>
                                    @if (!string.IsNullOrEmpty(lecturer.Department))
                                    {
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-building me-1"></i>@lecturer.Department
                                        </p>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(lecturer.CurrentStatus))
                            {
                                <div class="mb-3">
                                    <span class="badge @GetStatusBadgeClass(lecturer.CurrentStatus)">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>
                                        @lecturer.CurrentStatus
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(lecturer.PhoneNumber))
                            {
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-telephone me-1"></i>@lecturer.PhoneNumber
                                </p>
                            }

                            <div class="d-grid gap-2 mt-3">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="viewProfile(@lecturer.Id)">
                                    <i class="bi bi-eye me-1"></i> View Profile
                                </button>
                                @if (lecturer.CurrentStatus == "AVAILABLE")
                                {
                                    <a href="/Messages?with=@lecturer.Id&name=@Uri.EscapeDataString(lecturer.Name)" class="btn btn-success btn-sm">
                                        <i class="bi bi-chat-dots me-1"></i> Chat Now
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled title="Only available when lecturer is online and status is AVAILABLE">
                                        <i class="bi bi-chat-dots me-1"></i> Chat (Offline)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-search display-1 text-muted"></i>
                        <h5 class="mt-3">No lecturers found</h5>
                        <p class="text-muted">Try adjusting your search query</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "AVAILABLE" => "bg-success",
            "AVAILABLE_FOR_APPOINTMENT" => "bg-info",
            "IN_CLASS" => "bg-danger",
            "IN_MEETING" => "bg-warning",
            "AWAY" => "bg-secondary",
            "UNAVAILABLE" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}

<!-- Lecturer Profile Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="profileContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = new bootstrap.Modal(document.getElementById('profileModal'));
        const apiUrl = "@Model.Configuration["ApiSettings:BaseUrl"]";
        const token = "@HttpContext.Session.GetString("Token")";

        async function viewProfile(id) {
            modal.show();
            document.getElementById('profileContent').innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>`;

            try {
                const [userRes, statusRes, officeRes, scheduleRes] = await Promise.all([
                    fetch(`${apiUrl}/User/${id}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch(`${apiUrl}/LecturerStatus/lecturer/${id}/current`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch(`${apiUrl}/Office/staff/${id}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                    fetch(`${apiUrl}/LectureSchedule/lecturer/${id}`, { headers: { 'Authorization': `Bearer ${token}` } })
                ]);

                const user = await userRes.json();
                const statusData = statusRes.ok ? await statusRes.json() : null;
                const office = officeRes.ok ? await officeRes.json() : null;
                const schedules = scheduleRes.ok ? await scheduleRes.json() : [];

                let statusHtml = '';
                if (statusData) {
                    const status = statusData.status || statusData.Status;
                    const badgeClass = getBadgeClass(status);
                    statusHtml = `<span class="badge ${badgeClass} fs-6 mb-3"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>${status.replace('_', ' ')}</span>`;
                }

                let officeHtml = office ? `
                    <div class="card border-0 bg-light mb-4 rounded-4">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3"><i class="bi bi-building me-2"></i>Office Information</h6>
                            <div class="row small">
                                <div class="col-6 mb-2">
                                    <span class="text-muted d-block">Office Number</span>
                                    <strong>${office.officeNumber || office.OfficeNumber}</strong>
                                </div>
                                <div class="col-6 mb-2">
                                    <span class="text-muted d-block">Building</span>
                                    <strong>${office.building || office.Building}</strong>
                                </div>
                                <div class="col-12">
                                    <span class="text-muted d-block">Office Hours</span>
                                    <strong>${office.regularHours || office.RegularHours || 'Not specified'}</strong>
                                </div>
                            </div>
                        </div>
                    </div>` : '';

                let scheduleRows = schedules.length > 0 
                    ? schedules.map(s => `
                        <tr>
                            <td class="small fw-bold">${s.dayOfWeek || s.DayOfWeek}</td>
                            <td class="small">${s.startTime || s.StartTime} - ${s.endTime || s.EndTime}</td>
                            <td class="small">${s.courseName || s.CourseName}</td>
                            <td class="small"><span class="badge bg-primary opacity-75">${s.roomNumber || s.RoomNumber}</span></td>
                        </tr>`).join('')
                    : '<tr><td colspan="4" class="text-center text-muted py-3 small">No active schedule found</td></tr>';

                document.getElementById('profileContent').innerHTML = `
                    <div class="row">
                        <div class="col-md-5 text-center border-end">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-4 d-inline-flex mb-3 mt-2">
                                <i class="bi bi-person fs-1 text-primary"></i>
                            </div>
                            <h4 class="mb-1">${user.name || user.Name}</h4>
                            <p class="text-muted small mb-3">${user.email || user.Email}</p>
                            ${statusHtml}
                            
                            <div class="text-start px-3 mt-4">
                                <div class="mb-3">
                                    <small class="text-muted d-block">Department</small>
                                    <span class="fw-bold">${user.department || user.Department || 'General'}</span>
                                </div>
                                <div class="mb-3">
                                    <small class="text-muted d-block">Phone</small>
                                    <span class="fw-bold">${user.phoneNumber || user.PhoneNumber || '-'}</span>
                                </div>
                                <div class="mb-3">
                                    <small class="text-muted d-block">Identity Number</small>
                                    <span class="fw-bold">${user.identificationNumber || user.IdentificationNumber || '-'}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7 ps-md-4">
                            ${officeHtml}
                            <h6 class="fw-bold mb-3"><i class="bi bi-calendar3 me-2"></i>Weekly Schedule</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover border-top">
                                    <thead>
                                        <tr class="text-muted small">
                                            <th>Day</th>
                                            <th>Time</th>
                                            <th>Course</th>
                                            <th>Room</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${scheduleRows}
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-grid mt-4">
                                <a href="/Messages?with=${id}&name=${encodeURIComponent(user.name || user.Name)}" class="btn btn-success rounded-pill ${statusData && (statusData.status || statusData.Status) === 'AVAILABLE' ? '' : 'disabled'}">
                                    <i class="bi bi-chat-dots me-2"></i> Start Chat Now
                                </a>
                            </div>
                        </div>
                    </div>
                `;
            } catch (err) {
                document.getElementById('profileContent').innerHTML = `
                    <div class="alert alert-danger mx-3">
                        <i class="bi bi-exclamation-circle me-2"></i> Failed to load profile details. Please try again.
                    </div>`;
            }
        }

        function getBadgeClass(status) {
            switch(status) {
                case 'AVAILABLE': return 'bg-success';
                case 'AVAILABLE_FOR_APPOINTMENT': return 'bg-info';
                case 'IN_CLASS': return 'bg-danger';
                case 'IN_MEETING': return 'bg-warning';
                case 'AWAY': return 'bg-secondary';
                default: return 'bg-dark';
            }
        }
    </script>
}
