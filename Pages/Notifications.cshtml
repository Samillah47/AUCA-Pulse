@page
@model AUCAPulse.Pages.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6">Notifications</h1>
                    <p class="text-muted">Stay updated with your latest notifications</p>
                </div>
                @if (Model.UnreadCount > 0)
                {
                    <form method="post" asp-page-handler="MarkAllRead">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-check-all me-2"></i>Mark All as Read
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
        </div>
    }

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Total Notifications</h6>
                            <h3 class="mb-0">@Model.Notifications.Count</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-bell fs-3 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Unread</h6>
                            <h3 class="mb-0">@Model.UnreadCount</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-bell-fill fs-3 text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">All Notifications</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Notifications != null && Model.Notifications.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var notification in Model.Notifications)
                    {
                        <div class="list-group-item @(!notification.IsRead ? "bg-light" : "")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge @GetTypeBadgeClass(notification.Type) me-2">
                                            @notification.Type
                                        </span>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary">New</span>
                                        }
                                    </div>
                                    <h6 class="mb-2">@notification.Title</h6>
                                    <p class="mb-2 text-muted">@notification.Message</p>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                                <div class="ms-3">
                                    @if (!notification.IsRead)
                                    {
                                        <form method="post" asp-page-handler="MarkRead" asp-route-id="@notification.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Mark as read">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@notification.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash display-1 text-muted"></i>
                    <h5 class="mt-3">No notifications</h5>
                    <p class="text-muted">You're all caught up!</p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetTypeBadgeClass(string type)
    {
        return type switch
        {
            "SUCCESS" => "bg-success",
            "INFO" => "bg-info",
            "WARNING" => "bg-warning",
            "ERROR" => "bg-danger",
            "APPROVAL" => "bg-success",
            "REJECTION" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
