@page
@model AUCAPulse.Pages.RoomsModel
@{
    ViewData["Title"] = "Rooms";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6">Available Rooms</h1>
            <p class="text-muted">Find and book available rooms across campus</p>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" placeholder="Search by room number or building..." value="@Model.SearchQuery" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
            </form>
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                <option value="AVAILABLE">Available</option>
                <option value="OCCUPIED">Occupied</option>
                <option value="MAINTENANCE">Maintenance</option>
                <option value="RESERVED">Reserved</option>
            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- Rooms Grid -->
    <div class="row g-4">
        @if (Model.Rooms != null && Model.Rooms.Any())
        {
            @foreach (var room in Model.Rooms)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">Room @room.RoomNumber</h5>
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-building me-1"></i>@room.Building
                                        @if (!string.IsNullOrEmpty(room.Floor))
                                        {
                                            <span class="ms-2">
                                                <i class="bi bi-layers me-1"></i>Floor @room.Floor
                                            </span>
                                        }
                                    </p>
                                </div>
                                <span class="badge @GetStatusBadgeClass(room.Status)">
                                    @room.Status
                                </span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between text-muted small mb-2">
                                    <span><i class="bi bi-people me-1"></i>Capacity</span>
                                    <strong>@room.Capacity</strong>
                                </div>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span><i class="bi bi-tag me-1"></i>Type</span>
                                    <strong>@room.RoomType</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(room.Description))
                            {
                                <p class="text-muted small mb-3">@room.Description</p>
                            }

                            @if (room.Status == "AVAILABLE")
                            {
                                <a href="/Rooms/@room.Id" class="btn btn-primary btn-sm w-100">
                                    <i class="bi bi-door-open me-1"></i> View Details
                                </a>
                            }
                            else if (room.Status == "OCCUPIED")
                            {
                                <button class="btn btn-secondary btn-sm w-100" disabled>
                                    <i class="bi bi-lock me-1"></i> Currently Occupied
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                    @room.Status
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <h5 class="mt-3">No rooms found</h5>
                        <p class="text-muted">Try adjusting your search or filters</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "AVAILABLE" => "bg-success",
            "OCCUPIED" => "bg-danger",
            "MAINTENANCE" => "bg-warning",
            "RESERVED" => "bg-info",
            _ => "bg-secondary"
        };
    }
}
