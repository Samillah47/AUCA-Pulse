@page
@model AUCAPulse.Pages.RoomsModel
@{
    ViewData["Title"] = "Rooms";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="display-6 mb-1">Available Rooms</h1>
                <p class="text-muted mb-0">Find and book available rooms across campus</p>
            </div>
            @if (Model.UserRole == "LECTURER" || Model.UserRole == "STAFF" || Model.UserRole == "ADMIN")
            {
                <form method="post" asp-page-handler="AutoAssign" class="d-flex gap-2 align-items-center">
                    <select name="RoomTypeFilter" class="form-select form-select-sm" style="width: auto;">
                        <option value="">Any type</option>
                        <option value="LECTURE_HALL">Lecture Hall</option>
                        <option value="LAB">Lab</option>
                        <option value="MEETING_ROOM">Meeting Room</option>
                        <option value="OFFICE">Office</option>
                    </select>
                    <input type="number" name="DurationMinutes" value="120" min="15" max="480" class="form-control form-control-sm" style="width: 90px;" title="Duration (min)" />
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-lightning-charge me-1"></i>Auto-Assign Me a Room
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["AutoAssignSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-1"></i> @TempData["AutoAssignSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["AutoAssignError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["AutoAssignError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="row mb-4">
        <div class="col-md-12">
            <form method="get" class="row g-3">
                <div class="col-md-8">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Search by room number or building..." value="@Model.SearchQuery" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        <option value="AVAILABLE" selected="@(Model.SelectedStatus == "AVAILABLE")">Available</option>
                        <option value="OCCUPIED" selected="@(Model.SelectedStatus == "OCCUPIED")">Occupied</option>
                        <option value="MAINTENANCE" selected="@(Model.SelectedStatus == "MAINTENANCE")">Maintenance</option>
                        <option value="RESERVED" selected="@(Model.SelectedStatus == "RESERVED")">Reserved</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- Rooms Grid -->
    <div class="row g-4">
        @if (Model.Rooms != null && Model.Rooms.Any())
        {
            @foreach (var room in Model.Rooms)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">Room @room.RoomNumber</h5>
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-building me-1"></i>@room.Building
                                        @if (!string.IsNullOrEmpty(room.Floor))
                                        {
                                            <span class="ms-2">
                                                <i class="bi bi-layers me-1"></i>Floor @room.Floor
                                            </span>
                                        }
                                    </p>
                                </div>
                                <span class="badge @GetStatusBadgeClass(room.Status)">
                                    @room.Status
                                </span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between text-muted small mb-2">
                                    <span><i class="bi bi-people me-1"></i>Capacity</span>
                                    <strong>@room.Capacity</strong>
                                </div>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span><i class="bi bi-tag me-1"></i>Type</span>
                                    <strong>@room.RoomType</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(room.Description))
                            {
                                <p class="text-muted small mb-3">@room.Description</p>
                            }

                            @if (room.Status == "AVAILABLE")
                            {
                                <a href="/RoomDetails/@room.Id" class="btn btn-primary btn-sm w-100">
                                    <i class="bi bi-door-open me-1"></i> View Details
                                </a>
                            }
                            else if (room.Status == "OCCUPIED")
                            {
                                <a href="/RoomDetails/@room.Id" class="btn btn-secondary btn-sm w-100">
                                    <i class="bi bi-lock me-1"></i> Currently Occupied
                                </a>
                            }
                            else
                            {
                                <a href="/RoomDetails/@room.Id" class="btn btn-outline-secondary btn-sm w-100">
                                    @room.Status
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <h5 class="mt-3">No rooms found</h5>
                        <p class="text-muted">Try adjusting your search or filters</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "AVAILABLE" => "bg-success",
            "OCCUPIED" => "bg-danger",
            "MAINTENANCE" => "bg-warning",
            "RESERVED" => "bg-info",
            _ => "bg-secondary"
        };
    }
}
