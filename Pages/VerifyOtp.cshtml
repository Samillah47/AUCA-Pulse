@page
@model AUCAPulse.Pages.VerifyOtpModel
@{
    ViewData["Title"] = "Verify your email";
    Layout = null;
    var maskedEmail = string.IsNullOrWhiteSpace(Model.Email) ? "your inbox" : MaskEmail(Model.Email);
}
@functions {
    string MaskEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 1) return email;
        var name = email.Substring(0, at);
        var domain = email.Substring(at);
        if (name.Length <= 2) return name[0] + "*" + domain;
        return name[0] + new string('•', Math.Min(name.Length - 2, 6)) + name[^1] + domain;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email · AUCA Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            margin: 0;
            color: #111827;
        }
        .auth-shell { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
        @@media (max-width: 900px) { .auth-shell { grid-template-columns: 1fr; } .auth-showcase { display: none; } }

        .auth-form-col { display: flex; flex-direction: column; justify-content: center; padding: 3rem 2rem; }
        .auth-form-inner { width: 100%; max-width: 440px; margin: 0 auto; }

        .auth-brand { display: inline-flex; align-items: center; gap: 0.625rem; color: #111827; text-decoration: none; margin-bottom: 2rem; }
        .auth-brand-mark { width: 36px; height: 36px; border-radius: 10px; background: #2563eb; display: grid; place-items: center; color: #fff; }
        .auth-brand-text { font-weight: 700; letter-spacing: -0.01em; font-size: 1.0625rem; }
        .auth-brand-sub { color: #6b7280; font-size: 0.75rem; letter-spacing: 0.02em; }

        .otp-icon-wrap {
            width: 48px; height: 48px; border-radius: 12px;
            background: #eff6ff; color: #2563eb;
            display: grid; place-items: center;
            font-size: 1.375rem;
            margin-bottom: 1rem;
        }

        .auth-eyebrow { color: #6b7280; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; margin-bottom: 0.5rem; }
        .auth-title { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 0.5rem 0; }
        .auth-sub { color: #6b7280; font-size: 0.9375rem; margin-bottom: 1.75rem; }
        .auth-sub strong { color: #111827; font-weight: 600; }

        .otp-grid {
            display: flex;
            gap: 0.625rem;
            justify-content: space-between;
            margin-bottom: 0.875rem;
        }
        .otp-box {
            flex: 1;
            min-width: 0;
            aspect-ratio: 1 / 1;
            font-size: 1.5rem;
            font-weight: 600;
            text-align: center;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            color: #111827;
            background: #fff;
            font-family: 'Inter', system-ui, sans-serif;
            transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
        }
        .otp-box:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
            background: #fff;
        }
        .otp-box.filled { border-color: #2563eb; background: #eff6ff; }

        .validation { color: #ef4444; font-size: 0.8125rem; display: block; margin-bottom: 0.75rem; }

        .auth-submit {
            width: 100%;
            padding: 0.8125rem;
            background: #111827;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9375rem;
            cursor: pointer;
            transition: background-color .15s ease, transform .05s ease;
            margin-top: 0.5rem;
        }
        .auth-submit:hover { background: #2563eb; }
        .auth-submit:active { transform: translateY(1px); }

        .auth-alt { margin-top: 1.5rem; text-align: center; color: #6b7280; font-size: 0.875rem; }
        .auth-alt a { color: #2563eb; font-weight: 500; text-decoration: none; }
        .auth-alt a:hover { text-decoration: underline; }

        .auth-alert {
            padding: 0.625rem 0.875rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            display: flex; gap: 0.5rem; align-items: flex-start;
        }
        .auth-alert.err { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
        .auth-alert.ok  { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }

        .auth-note {
            margin-top: 1.5rem;
            font-size: 0.8125rem;
            color: #6b7280;
            padding: 0.625rem 0.875rem;
            background: #f9fafb;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            text-align: center;
        }

        .timer { color: #2563eb; font-weight: 600; font-variant-numeric: tabular-nums; }

        /* Showcase (same as Login/Signup) */
        .auth-showcase {
            background: #0f172a;
            color: #e2e8f0;
            padding: 3rem 3rem 3rem 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }
        .auth-showcase::before {
            content: '';
            position: absolute;
            top: -120px; right: -120px;
            width: 340px; height: 340px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.10);
            filter: blur(4px);
        }
        .auth-showcase::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -40px;
            width: 220px; height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.03);
        }
        .auth-showcase .stamp {
            position: relative;
            display: inline-block;
            padding: 0.375rem 0.75rem;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 999px;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #94a3b8;
        }
        .auth-showcase h1 {
            position: relative;
            font-size: 2.25rem;
            line-height: 1.15;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin: 1.25rem 0 1rem 0;
        }
        .auth-showcase .lead {
            position: relative;
            color: #94a3b8;
            font-size: 1rem;
            line-height: 1.55;
            max-width: 38ch;
            margin-bottom: 2rem;
        }
        .shield-ring {
            position: relative;
            display: flex;
            align-items: center;
            gap: 0.875rem;
            padding: 1rem 1.125rem;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            max-width: 380px;
        }
        .shield-ring i { font-size: 1.5rem; color: #60a5fa; flex-shrink: 0; }
        .shield-ring-text .strong { color: #e2e8f0; font-weight: 600; }
        .shield-ring-text .muted  { color: #94a3b8; font-size: 0.875rem; display: block; }

        .auth-showcase .footnote { position: relative; color: #64748b; font-size: 0.75rem; letter-spacing: 0.06em; }
    </style>
</head>
<body>
<div class="auth-shell">
    <!-- Form column -->
    <section class="auth-form-col">
        <div class="auth-form-inner">
            <a href="/" class="auth-brand">
                <span class="auth-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v8" />
                        <path d="M4.9 9.1l5.7 5.7" />
                        <path d="M19.1 9.1l-5.7 5.7" />
                        <circle cx="12" cy="17" r="4" />
                    </svg>
                </span>
                <span>
                    <span class="auth-brand-text d-block">AUCA Pulse</span>
                    <span class="auth-brand-sub">Smart Campus</span>
                </span>
            </a>

            <div class="otp-icon-wrap" aria-hidden="true">
                <i class="bi bi-shield-lock"></i>
            </div>

            <div class="auth-eyebrow">Two-step verification</div>
            <h1 class="auth-title">Enter the 6-digit code</h1>
            <p class="auth-sub">
                We sent a code to <strong>@maskedEmail</strong>. The code expires in
                <span class="timer" id="otpTimer">5:00</span>.
            </p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert err">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert ok">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            <form method="post" id="otpForm" novalidate>
                <!-- Hidden bound input receives the concatenated 6-digit code -->
                <input asp-for="OtpCode" id="OtpCode" type="hidden" />

                <div class="otp-grid" id="otpGrid">
                    <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" autofocus />
                    <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 2" />
                    <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 3" />
                    <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 4" />
                    <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 5" />
                    <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 6" />
                </div>
                <span asp-validation-for="OtpCode" class="validation"></span>

                <button type="submit" class="auth-submit">Verify code</button>
            </form>

            <div class="auth-note">
                <i class="bi bi-info-circle me-1"></i>
                Didn't get a code? Check your spam folder or <a href="/Login">try signing in again</a>.
            </div>

            <div class="auth-alt">
                <a href="/Login"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
            </div>
        </div>
    </section>

    <!-- Showcase column -->
    <aside class="auth-showcase">
        <div>
            <span class="stamp">Secure sign-in</span>
            <h1>A six-digit nudge for a safer account.</h1>
            <p class="lead">Two-step verification keeps your AUCA Pulse account yours, even if your password ever leaks.</p>

            <div class="shield-ring">
                <i class="bi bi-shield-check"></i>
                <div class="shield-ring-text">
                    <span class="strong">You're protected</span>
                    <span class="muted">Codes are single-use and expire quickly.</span>
                </div>
            </div>
        </div>
        <div class="footnote">© @DateTime.Now.Year AUCA Pulse</div>
    </aside>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    (function () {
        const boxes = Array.from(document.querySelectorAll('#otpGrid .otp-box'));
        const hidden = document.getElementById('OtpCode');
        const form = document.getElementById('otpForm');

        function syncHidden() {
            hidden.value = boxes.map(b => b.value || '').join('');
            boxes.forEach(b => b.classList.toggle('filled', !!b.value));
        }

        // Prefill hidden's first boxes if a previous value exists (e.g. server-returned error)
        if (hidden.value && /^\d+$/.test(hidden.value)) {
            const digits = hidden.value.substring(0, 6).split('');
            for (let i = 0; i < digits.length; i++) boxes[i].value = digits[i];
            syncHidden();
        }

        boxes.forEach((box, i) => {
            box.addEventListener('input', (e) => {
                // Keep only the last entered digit
                const clean = (box.value || '').replace(/\D/g, '').slice(-1);
                box.value = clean;
                syncHidden();
                if (clean && i < boxes.length - 1) boxes[i + 1].focus();
                // Auto-submit once all six are filled
                if (hidden.value.length === 6) form.submit();
            });

            box.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace') {
                    if (!box.value && i > 0) {
                        boxes[i - 1].focus();
                        boxes[i - 1].value = '';
                        syncHidden();
                        e.preventDefault();
                    }
                } else if (e.key === 'ArrowLeft' && i > 0) {
                    boxes[i - 1].focus(); e.preventDefault();
                } else if (e.key === 'ArrowRight' && i < boxes.length - 1) {
                    boxes[i + 1].focus(); e.preventDefault();
                }
            });

            box.addEventListener('paste', (e) => {
                const text = (e.clipboardData || window.clipboardData).getData('text');
                const digits = (text || '').replace(/\D/g, '').slice(0, 6).split('');
                if (digits.length === 0) return;
                e.preventDefault();
                for (let k = 0; k < 6; k++) boxes[k].value = digits[k] || '';
                syncHidden();
                (boxes[Math.min(digits.length, 5)] || boxes[5]).focus();
                if (hidden.value.length === 6) form.submit();
            });

            box.addEventListener('focus', () => box.select());
        });

        // 5-minute countdown timer (display only)
        const timerEl = document.getElementById('otpTimer');
        if (timerEl) {
            let secondsLeft = 5 * 60;
            const tick = () => {
                const m = Math.floor(secondsLeft / 60);
                const s = secondsLeft % 60;
                timerEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                if (secondsLeft <= 0) {
                    timerEl.textContent = 'expired';
                    timerEl.style.color = '#ef4444';
                    return;
                }
                secondsLeft--;
                setTimeout(tick, 1000);
            };
            tick();
        }
    })();
</script>
</body>
</html>
