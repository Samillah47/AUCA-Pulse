@page
@model AUCAPulse.Pages.VerifyOtpModel
@{
    ViewData["Title"] = "Verify OTP - ACPulse";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .otp-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 60px;
            max-width: 500px;
            width: 100%;
            text-align: center;
        }
        .otp-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            font-size: 40px;
        }
        .otp-input {
            width: 60px;
            height: 60px;
            font-size: 24px;
            text-align: center;
            margin: 0 5px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
        }
        .otp-input:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .btn-primary-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="otp-container">
        <div class="otp-icon text-white">
            🔐
        </div>

        <h2 class="mb-3">Verify Your Identity</h2>
        <p class="text-muted mb-4">
            We've sent a 6-digit code to<br />
            <strong>@Model.Email</strong>
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="alert">
                @Model.SuccessMessage
            </div>
        }

        <form method="post">
            <div class="d-flex justify-content-center mb-4">
                <input type="text" asp-for="OtpCode" class="form-control otp-input" maxlength="6" placeholder="000000" autofocus />
            </div>
            <span asp-validation-for="OtpCode" class="text-danger d-block mb-3"></span>

            <button type="submit" class="btn btn-primary-custom btn-lg w-100 mb-3">
                Verify Code
            </button>
        </form>

        <div class="mt-4">
            <p class="text-muted small">
                Didn't receive the code?
                <a href="#" class="text-primary fw-bold">Resend Code</a>
            </p>
            <a href="/Login" class="text-muted small">Back to Login</a>
        </div>

        <div class="mt-4 pt-4 border-top">
            <p class="text-muted small mb-0">
                <i class="bi bi-shield-check"></i> Your code expires in 5 minutes
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
