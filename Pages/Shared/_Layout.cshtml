@{
    var token = Context.Session.GetString("Token");
    var userName = Context.Session.GetString("UserName") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "STUDENT";
    var isAuthenticated = !string.IsNullOrEmpty(token);
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AUCA Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@functions {
    bool IsActive(string prefix) =>
        !string.IsNullOrEmpty(prefix) && (Context.Request.Path.Value ?? string.Empty)
            .StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}

@if (isAuthenticated)
{
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v8" />
                        <path d="M4.9 9.1l5.7 5.7" />
                        <path d="M19.1 9.1l-5.7 5.7" />
                        <circle cx="12" cy="17" r="4" />
                    </svg>
                </div>
                <div>
                    <div class="brand-text">AUCA Pulse</div>
                    <div class="brand-sub">Smart Campus</div>
                </div>
            </div>

            <nav aria-label="Primary">
                <a class="nav-link @(IsActive("/Dashboard") ? "active" : "")" href="/Dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(IsActive("/Rooms") || IsActive("/RoomDetails") ? "active" : "")" href="/Rooms">
                    <i class="bi bi-door-open"></i> Rooms
                </a>
                @if (userRole != "LECTURER")
                {
                    <a class="nav-link @(IsActive("/Lecturers") ? "active" : "")" href="/Lecturers">
                        <i class="bi bi-people"></i> Lecturers
                    </a>
                }
                @if (userRole == "LECTURER")
                {
                    <a class="nav-link @(IsActive("/Schedule") ? "active" : "")" href="/Schedule">
                        <i class="bi bi-calendar"></i> My Schedule
                    </a>
                }
                <a class="nav-link @(IsActive("/Notifications") ? "active" : "")" href="/Notifications">
                    <i class="bi bi-bell"></i> Notifications
                </a>
                @if (userRole != "LECTURER")
                {
                    <a class="nav-link @(IsActive("/Profile") ? "active" : "")" href="/Profile">
                        <i class="bi bi-person"></i> Profile
                    </a>
                }
                @if (userRole == "STAFF")
                {
                    <a class="nav-link @(IsActive("/MyOffice") ? "active" : "")" href="/MyOffice">
                        <i class="bi bi-building"></i> My Office
                    </a>
                }

                @if (userRole == "ADMIN")
                {
                    <div class="nav-group-label">Admin</div>
                    <a class="nav-link @(IsActive("/VerificationRequests") ? "active" : "")" href="/VerificationRequests">
                        <i class="bi bi-check-circle"></i> Verifications
                    </a>
                    <a class="nav-link @(IsActive("/UserManagement") ? "active" : "")" href="/UserManagement">
                        <i class="bi bi-people"></i> Users
                    </a>
                    <a class="nav-link @(IsActive("/Courses") ? "active" : "")" href="/Courses">
                        <i class="bi bi-book"></i> Courses
                    </a>
                    <a class="nav-link @(IsActive("/CourseAssignment") ? "active" : "")" href="/CourseAssignment">
                        <i class="bi bi-journal-check"></i> Assign Courses
                    </a>
                    <a class="nav-link @(IsActive("/TimetableGenerator") ? "active" : "")" href="/TimetableGenerator">
                        <i class="bi bi-calendar-week"></i> Timetable
                    </a>
                    <a class="nav-link @(IsActive("/Reports") ? "active" : "")" href="/Reports">
                        <i class="bi bi-bar-chart"></i> Reports
                    </a>
                    <a class="nav-link @(IsActive("/PasswordResets") ? "active" : "")" href="/PasswordResets">
                        <i class="bi bi-key"></i> Password Resets
                    </a>
                }

                @if (userRole != "LECTURER")
                {
                    <hr />
                    <a class="nav-link" href="/Logout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <header class="topbar">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <!-- Notification Bell -->
                    <a href="/Notifications" class="text-secondary position-relative me-2" title="Notifications">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="headerUnreadCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem; padding: 0.25em 0.4em;">
                            0
                        </span>
                    </a>

                    <span class="badge bg-primary">@userRole</span>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@userName
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/Profile">Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Logout">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </header>
            <main class="page">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main role="main">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/toast.js" asp-append-version="true"></script>

@if (isAuthenticated)
{
    <script>
        $(document).ready(function() {
            const userId = "@Context.Session.GetString("UserId")";
            const token = "@Context.Session.GetString("Token")";
            // Get base URL from common local dev port or use window.location if hosted
            const baseUrl = "https://localhost:7255/api"; 

            function updateUnreadCount() {
                if (!userId || !token) return;

                fetch(`${baseUrl}/Notification/user/${userId}/unread-count`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                })
                .then(res => res.json())
                .then(data => {
                    const count = data.count || 0;
                    const badge = $('#headerUnreadCount');
                    if (count > 0) {
                        badge.text(count).removeClass('d-none');
                    } else {
                        badge.addClass('d-none');
                    }
                })
                .catch(err => console.error('Error fetching notifications:', err));
            }

            // Initial load and poll every 10 seconds
            updateUnreadCount();
            setInterval(updateUnreadCount, 10000);
        });
    </script>
}

<partial name="_Toasts" />

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
