@page "{id:int}"
@model AUCAPulse.Pages.RoomDetails.IndexModel
@{
    ViewData["Title"] = $"Room {Model.Room?.RoomNumber}";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <a href="/Rooms" class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> Back to Rooms
            </a>
        </div>
    </div>

    @if (Model.Room != null)
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h2 class="mb-2">Room @Model.Room.RoomNumber</h2>
                                <p class="text-muted mb-0">
                                    <i class="bi bi-building me-2"></i>@Model.Room.Building
                                    @if (!string.IsNullOrEmpty(Model.Room.Floor))
                                    {
                                        <span class="ms-3">
                                            <i class="bi bi-layers me-2"></i>Floor @Model.Room.Floor
                                        </span>
                                    }
                                </p>
                            </div>
                            <span class="badge @GetStatusBadgeClass(Model.Room.Status) fs-6">
                                @Model.Room.Status
                            </span>
                        </div>

                        <hr />

                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="text-center p-3 bg-light rounded">
                                    <i class="bi bi-people fs-1 text-primary"></i>
                                    <h5 class="mt-2 mb-0">@Model.Room.Capacity</h5>
                                    <small class="text-muted">Capacity</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center p-3 bg-light rounded">
                                    <i class="bi bi-tag fs-1 text-primary"></i>
                                    <h5 class="mt-2 mb-0">@Model.Room.RoomType</h5>
                                    <small class="text-muted">Room Type</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center p-3 bg-light rounded">
                                    <i class="bi bi-door-open fs-1 text-primary"></i>
                                    <h5 class="mt-2 mb-0">@Model.Room.Status</h5>
                                    <small class="text-muted">Current Status</small>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Room.Description))
                        {
                            <div class="mb-4">
                                <h5>Description</h5>
                                <p class="text-muted">@Model.Room.Description</p>
                            </div>
                        }

                        @if (Model.ActiveNow != null)
                        {
                            <div class="card border-0 mb-4" style="background:#fef2f2;border:1px solid #fecaca !important;">
                                <div class="card-body">
                                    <div class="d-flex align-items-start gap-3">
                                        <div style="width:44px;height:44px;border-radius:10px;background:#fee2e2;color:#b91c1c;display:grid;place-items:center;flex-shrink:0;">
                                            <i class="bi bi-broadcast fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <h5 class="mb-0 text-danger">
                                                    <i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>Class in session now
                                                </h5>
                                            </div>
                                            <div class="fw-semibold fs-5">
                                                @Model.ActiveNow.CourseCode
                                                @if (!string.IsNullOrWhiteSpace(Model.ActiveNow.CourseName))
                                                {
                                                    <span class="text-muted fw-normal"> — @Model.ActiveNow.CourseName</span>
                                                }
                                            </div>
                                            <div class="mt-2 d-flex flex-wrap gap-3 text-muted small">
                                                <span><i class="bi bi-person me-1"></i>@Model.ActiveNow.LecturerName</span>
                                                <span>
                                                    <i class="bi bi-clock me-1"></i>
                                                    @Model.ActiveNow.StartTime.Substring(0, Math.Min(5, Model.ActiveNow.StartTime.Length))
                                                    -
                                                    @Model.ActiveNow.EndTime.Substring(0, Math.Min(5, Model.ActiveNow.EndTime.Length))
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(Model.ActiveNow.GroupName))
                                                {
                                                    <span><i class="bi bi-people me-1"></i>Group @Model.ActiveNow.GroupName</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Model.ActiveNow.SemesterName))
                                                {
                                                    <span><i class="bi bi-calendar3 me-1"></i>@Model.ActiveNow.SemesterName</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.Room.Status == "OCCUPIED" || Model.Room.Status == "RESERVED" || Model.Room.CurrentLecturerId.HasValue)
                        {
                            <div class="card border-0 bg-light mb-4">
                                <div class="card-body">
                                    <h5 class="card-title text-primary"><i class="bi bi-info-circle me-2"></i>Occupancy Details</h5>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <p class="mb-1 text-muted small">Lecturer in Charge</p>
                                            <p class="fw-bold">@(Model.Room.CurrentLecturerName ?? $"user #{Model.Room.CurrentLecturerId}")</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-1 text-muted small">Activity / Course</p>
                                            <p class="fw-bold">@(string.IsNullOrEmpty(Model.Room.CourseInfo) ? "General Activity" : Model.Room.CourseInfo)</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-1 text-muted small">From</p>
                                            <p class="fw-bold">@(Model.Room.OccupiedAt?.ToLocalTime().ToString("HH:mm") ?? "-")</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-1 text-muted small">Until</p>
                                            <p class="fw-bold text-danger">@(Model.Room.OccupiedUntil?.ToLocalTime().ToString("HH:mm") ?? "-")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Weekly class schedule for this room -->
                @{
                    var dayOrder = new[] { "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" };
                    var grouped = Model.Schedule
                        .GroupBy(s => (s.DayOfWeek ?? string.Empty).ToUpperInvariant())
                        .OrderBy(g => Array.IndexOf(dayOrder, g.Key) is int idx && idx >= 0 ? idx : int.MaxValue);
                }
                <div class="card border-0 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0"><i class="bi bi-calendar-week me-2"></i>Weekly Schedule</h5>
                            <small class="text-muted">Classes assigned to this room</small>
                        </div>
                        <span class="badge bg-primary">@Model.Schedule.Count entries</span>
                    </div>
                    <div class="card-body">
                        @if (!Model.Schedule.Any())
                        {
                            <div class="empty-state">
                                <i class="bi bi-calendar-x"></i>
                                <h5>No classes scheduled</h5>
                                <div>This room has no lectures in the generated timetable yet.</div>
                            </div>
                        }
                        else
                        {
                            @foreach (var dayGroup in grouped)
                            {
                                <h6 class="mt-2 mb-2 text-muted">@dayGroup.Key</h6>
                                <div class="table-responsive mb-3">
                                    <table class="table table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 140px;">Time</th>
                                                <th>Course</th>
                                                <th style="width: 90px;">Group</th>
                                                <th>Lecturer</th>
                                                <th>Semester</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var entry in dayGroup.OrderBy(e => e.StartTime))
                                        {
                                            <tr>
                                                <td>
                                                    @entry.StartTime.Substring(0, Math.Min(5, entry.StartTime.Length))
                                                    -
                                                    @entry.EndTime.Substring(0, Math.Min(5, entry.EndTime.Length))
                                                </td>
                                                <td>
                                                    <strong>@entry.CourseCode</strong>
                                                    @if (!string.IsNullOrWhiteSpace(entry.CourseName))
                                                    {
                                                        <span class="text-muted"> — @entry.CourseName</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(entry.GroupName))
                                                    {
                                                        <span class="badge bg-primary">Group @entry.GroupName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>@entry.LecturerName</td>
                                                <td class="text-muted small">@(entry.SemesterName ?? "-")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Actions</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Room.Status == "AVAILABLE" && Model.CanOccupy)
                        {
                            <form method="post" asp-page-handler="Occupy">
                                <input type="hidden" name="roomId" value="@Model.Room.Id" />
                                <div class="mb-3">
                                    <label class="form-label">Reservation Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Today.ToString("MMMM dd, yyyy")" disabled />
                                    <small class="text-muted">Reservations are for today only.</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Course or Activity</label>
                                    <input type="text" name="courseInfo" class="form-control" placeholder="e.g., CS201 Lab, Faculty Meeting" required />
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label class="form-label">Start Time</label>
                                        <input type="time" name="startTime" class="form-control" value="@DateTime.Now.ToString("HH:mm")" required />
                                    </div>
                                    <div class="col">
                                        <label class="form-label">End Time</label>
                                        <input type="time" name="endTime" class="form-control" value="@DateTime.Now.AddHours(2).ToString("HH:mm")" required />
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-calendar-check me-2"></i>Reserve Room
                                </button>
                            </form>
                        }
                        else if (Model.Room.Status == "AVAILABLE")
                        {
                            <div class="text-muted small">
                                <i class="bi bi-info-circle me-1"></i>
                                Only lecturers can occupy a room for a class session.
                            </div>
                        }
                        else if (Model.Room.Status == "OCCUPIED" || Model.Room.Status == "RESERVED")
                        {
                            <button class="btn btn-outline-secondary w-100" disabled>
                                <i class="bi bi-lock me-2"></i>@(Model.Room.Status == "OCCUPIED" ? "Currently Occupied" : "Reserved")
                            </button>
                            @if (Model.CanRelease)
                            {
                                <form method="post" asp-page-handler="Release" class="mt-2">
                                    <input type="hidden" name="roomId" value="@Model.Room.Id" />
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-unlock me-2"></i>Release Room
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary w-100" disabled>
                                Room @Model.Room.Status
                            </button>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Room Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted">Room Number</small>
                            <p class="mb-0 fw-bold">@Model.Room.RoomNumber</p>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted">Building</small>
                            <p class="mb-0 fw-bold">@Model.Room.Building</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Room.Floor))
                        {
                            <div class="mb-3">
                                <small class="text-muted">Floor</small>
                                <p class="mb-0 fw-bold">@Model.Room.Floor</p>
                            </div>
                        }
                        <div class="mb-0">
                            <small class="text-muted">Created</small>
                            <p class="mb-0 fw-bold">@Model.Room.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Room not found or an error occurred.
        </div>
    }
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "AVAILABLE" => "bg-success",
            "OCCUPIED" => "bg-danger",
            "MAINTENANCE" => "bg-warning",
            "RESERVED" => "bg-info",
            _ => "bg-secondary"
        };
    }
}
