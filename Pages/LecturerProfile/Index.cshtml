@page "{id:int}"
@model AUCAPulse.Pages.LecturerProfile.IndexModel
@{
    ViewData["Title"] = $"{Model.Lecturer?.Name} - Profile";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <a href="/Lecturers" class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> Back to Lecturers
            </a>
        </div>
    </div>

    @if (Model.Lecturer != null)
    {
        <div class="row">
            <div class="col-lg-4">
                <!-- Profile Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-4 d-inline-flex mb-3">
                            <i class="bi bi-person fs-1 text-primary"></i>
                        </div>
                        <h3 class="mb-2">@Model.Lecturer.Name</h3>
                        <p class="text-muted mb-3">@Model.Lecturer.Email</p>

                        @if (!string.IsNullOrEmpty(Model.CurrentStatus))
                        {
                            <span class="badge @GetStatusBadgeClass(Model.CurrentStatus) fs-6 mb-3">
                                <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>
                                @Model.CurrentStatus
                            </span>
                        }

                        <hr />

                        <div class="text-start">
                            @if (!string.IsNullOrEmpty(Model.Lecturer.Department))
                            {
                                <div class="mb-3">
                                    <small class="text-muted">Department</small>
                                    <p class="mb-0 fw-bold">@Model.Lecturer.Department</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Lecturer.PhoneNumber))
                            {
                                <div class="mb-3">
                                    <small class="text-muted">Phone</small>
                                    <p class="mb-0 fw-bold">@Model.Lecturer.PhoneNumber</p>
                                </div>
                            }
                            <div class="mb-0">
                                <small class="text-muted">Email</small>
                                <p class="mb-0 fw-bold">@Model.Lecturer.Email</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Office Information -->
                @if (Model.Office != null)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Office Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <small class="text-muted">Office Number</small>
                                <p class="mb-0 fw-bold">@Model.Office.OfficeNumber</p>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Building</small>
                                <p class="mb-0 fw-bold">@Model.Office.Building</p>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Status</small>
                                <p class="mb-0">
                                    <span class="badge bg-@(Model.Office.AvailabilityStatus == "OPEN" ? "success" : "secondary")">
                                        @Model.Office.AvailabilityStatus
                                    </span>
                                </p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Office.RegularHours))
                            {
                                <div class="mb-0">
                                    <small class="text-muted">Office Hours</small>
                                    <p class="mb-0 fw-bold">@Model.Office.RegularHours</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-8">
                <!-- Schedule Card -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Lecture Schedule</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Schedules != null && Model.Schedules.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Day</th>
                                            <th>Time</th>
                                            <th>Course</th>
                                            <th>Room</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var schedule in Model.Schedules.OrderBy(s => s.DayOfWeek))
                                        {
                                            <tr>
                                                <td><strong>@schedule.DayOfWeek</strong></td>
                                                <td>@schedule.StartTime - @schedule.EndTime</td>
                                                <td>@schedule.CourseName</td>
                                                <td>
                                                    <span class="badge bg-primary">@schedule.RoomNumber</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-calendar-x display-1 text-muted"></i>
                                <h5 class="mt-3">No schedule available</h5>
                                <p class="text-muted">This lecturer has no scheduled classes at the moment</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Status History -->
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Recent Status Updates</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var status in Model.StatusHistory.Take(5))
                                {
                                    <div class="list-group-item px-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="badge @GetStatusBadgeClass(status.Status)">
                                                    @status.Status
                                                </span>
                                                @if (!string.IsNullOrEmpty(status.Notes))
                                                {
                                                    <span class="ms-2 text-muted">@status.Notes</span>
                                                }
                                            </div>
                                            <small class="text-muted">@status.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No status history available</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Lecturer not found or an error occurred.
        </div>
    }
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "AVAILABLE" => "bg-success",
            "IN_CLASS" => "bg-danger",
            "IN_MEETING" => "bg-warning",
            "ON_LEAVE" => "bg-secondary",
            "UNAVAILABLE" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}
