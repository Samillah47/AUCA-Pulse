@page
@model AUCAPulse.Pages.GroupsModel
@{
    ViewData["Title"] = "Groups";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people me-2"></i>Class Groups</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addGroupModal">
            <i class="bi bi-plus-circle me-1"></i> Add Group
        </button>
    </div>

    <p class="text-muted">
        Groups split a single course into parallel sections so different lecturers can teach different students.
        Groups A, B, C, and D are created by default — add more here if you need them.
    </p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" data-paginate="5">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Name</th>
                            <th>Description</th>
                            <th style="width: 160px;">Created</th>
                            <th style="width: 90px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Groups.Any())
                        {
                            <tr data-no-paginate><td colspan="4">
                                <div class="empty-state">
                                    <i class="bi bi-people"></i>
                                    <h5>No groups yet</h5>
                                    <div>Click <strong>Add Group</strong> above to create one.</div>
                                </div>
                            </td></tr>
                        }
                        @foreach (var g in Model.Groups)
                        {
                            <tr>
                                <td><span class="badge bg-primary">Group @g.Name</span></td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(g.Description) ? "-" : g.Description)</td>
                                <td class="text-muted small">@g.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="groupId" value="@g.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Delete this group? This only works if no assignments use it.')"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name *</label>
                        <input asp-for="NewName" class="form-control" placeholder="e.g. E or 1A" required maxlength="50" />
                        <div class="form-text">A short label. Must be unique.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="NewDescription" class="form-control" rows="2" placeholder="Optional — e.g. Evening group"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Group</button>
                </div>
            </div>
        </form>
    </div>
</div>
