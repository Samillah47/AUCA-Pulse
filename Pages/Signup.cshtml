@page
@model AUCAPulse.Pages.SignupModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account · AUCA Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            margin: 0;
            color: #111827;
        }
        .auth-shell { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
        @@media (max-width: 1000px) { .auth-shell { grid-template-columns: 1fr; } .auth-showcase { display: none; } }

        .auth-form-col {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 3rem 2rem;
        }
        .auth-form-inner { width: 100%; max-width: 520px; margin: 0 auto; }

        .auth-brand { display: inline-flex; align-items: center; gap: 0.625rem; color: #111827; text-decoration: none; margin-bottom: 1.75rem; }
        .auth-brand-mark { width: 36px; height: 36px; border-radius: 10px; background: #2563eb; display: grid; place-items: center; color: #fff; }
        .auth-brand-text { font-weight: 700; letter-spacing: -0.01em; font-size: 1.0625rem; }
        .auth-brand-sub { color: #6b7280; font-size: 0.75rem; letter-spacing: 0.02em; }

        .auth-eyebrow { color: #6b7280; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; margin-bottom: 0.5rem; }
        .auth-title { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 0.375rem 0; }
        .auth-sub { color: #6b7280; margin-bottom: 1.75rem; font-size: 0.9375rem; }

        .auth-field { margin-bottom: 0.875rem; }
        .auth-field label { font-weight: 500; font-size: 0.875rem; margin-bottom: 0.375rem; display: block; color: #111827; }
        .auth-field label .muted { color: #9ca3af; font-weight: 400; margin-left: 0.25rem; }
        .auth-field input, .auth-field select {
            width: 100%;
            padding: 0.6875rem 0.875rem;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 0.9375rem;
            background: #fff;
            color: #111827;
            transition: border-color .15s ease, box-shadow .15s ease;
            font-family: inherit;
        }
        .auth-field input::placeholder { color: #9ca3af; }
        .auth-field input:focus, .auth-field select:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }
        .auth-field .validation { color: #ef4444; font-size: 0.8125rem; margin-top: 0.25rem; display: block; }

        .auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
        @@media (max-width: 560px) { .auth-row { grid-template-columns: 1fr; } }

        .auth-submit {
            width: 100%;
            padding: 0.8125rem;
            background: #111827;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9375rem;
            cursor: pointer;
            transition: background-color .15s ease, transform .05s ease;
            margin-top: 0.5rem;
        }
        .auth-submit:hover { background: #2563eb; }
        .auth-submit:active { transform: translateY(1px); }

        .auth-alt { margin-top: 1.25rem; text-align: center; color: #6b7280; font-size: 0.875rem; }
        .auth-alt a { color: #2563eb; font-weight: 500; text-decoration: none; }
        .auth-alt a:hover { text-decoration: underline; }

        .auth-alert {
            padding: 0.625rem 0.875rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            display: flex; gap: 0.5rem; align-items: flex-start;
        }
        .auth-alert.err { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
        .auth-alert.ok  { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }

        .auth-note {
            margin-top: 1.25rem;
            font-size: 0.8125rem;
            color: #6b7280;
            padding: 0.625rem 0.875rem;
            background: #f9fafb;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
        }

        /* Showcase column */
        .auth-showcase {
            background: #0f172a;
            color: #e2e8f0;
            padding: 3rem 3rem 3rem 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }
        .auth-showcase::before {
            content: '';
            position: absolute;
            top: -120px; right: -120px;
            width: 340px; height: 340px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.10);
            filter: blur(4px);
        }
        .auth-showcase::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -40px;
            width: 220px; height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.03);
        }
        .auth-showcase .stamp {
            position: relative;
            display: inline-block;
            padding: 0.375rem 0.75rem;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 999px;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #94a3b8;
        }
        .auth-showcase h1 {
            position: relative;
            font-size: 2.25rem;
            line-height: 1.15;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin: 1.25rem 0 1rem 0;
        }
        .auth-showcase .lead {
            position: relative;
            color: #94a3b8;
            font-size: 1rem;
            line-height: 1.55;
            max-width: 38ch;
            margin-bottom: 2rem;
        }
        .auth-quote {
            position: relative;
            padding-left: 0.875rem;
            border-left: 2px solid #3b82f6;
            color: #cbd5e1;
            font-size: 0.9375rem;
            line-height: 1.55;
            max-width: 42ch;
        }
        .auth-quote-attrib { color: #64748b; font-size: 0.8125rem; margin-top: 0.5rem; }
        .auth-showcase .footnote { position: relative; color: #64748b; font-size: 0.75rem; letter-spacing: 0.06em; }
    </style>
</head>
<body>
<div class="auth-shell">
    <!-- Form column -->
    <section class="auth-form-col">
        <div class="auth-form-inner">
            <a href="/" class="auth-brand">
                <span class="auth-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v8" />
                        <path d="M4.9 9.1l5.7 5.7" />
                        <path d="M19.1 9.1l-5.7 5.7" />
                        <circle cx="12" cy="17" r="4" />
                    </svg>
                </span>
                <span>
                    <span class="auth-brand-text d-block">AUCA Pulse</span>
                    <span class="auth-brand-sub">Smart Campus</span>
                </span>
            </a>

            <div class="auth-eyebrow">Create account</div>
            <h1 class="auth-title">Join AUCA Pulse</h1>
            <p class="auth-sub">Fill in your details below. Your account will be reviewed by an administrator before activation.</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert err">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert ok">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            <form method="post" novalidate>
                <div class="auth-field">
                    <label asp-for="Name">Full name</label>
                    <input asp-for="Name" placeholder="John Doe" autocomplete="name" />
                    <span asp-validation-for="Name" class="validation"></span>
                </div>

                <div class="auth-row">
                    <div class="auth-field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" placeholder="your.email@auca.ac.rw" autocomplete="email" />
                        <span asp-validation-for="Email" class="validation"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="IdentificationNumber">Student / staff ID</label>
                        <input asp-for="IdentificationNumber" placeholder="e.g. 26751" />
                        <span asp-validation-for="IdentificationNumber" class="validation"></span>
                    </div>
                </div>

                <div class="auth-row">
                    <div class="auth-field">
                        <label asp-for="RoleType">Role</label>
                        <select asp-for="RoleType">
                            <option value="STUDENT">Student</option>
                            <option value="LECTURER">Lecturer</option>
                            <option value="STAFF">Staff</option>
                        </select>
                        <span asp-validation-for="RoleType" class="validation"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="Department">Department <span class="muted">· optional</span></label>
                        <input asp-for="Department" placeholder="e.g. Computer Science" />
                        <span asp-validation-for="Department" class="validation"></span>
                    </div>
                </div>

                <div class="auth-field">
                    <label asp-for="PhoneNumber">Phone number <span class="muted">· optional</span></label>
                    <input asp-for="PhoneNumber" placeholder="+250 ..." autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="validation"></span>
                </div>

                <div class="auth-row">
                    <div class="auth-field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" placeholder="At least 6 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="validation"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">Confirm password</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Repeat your password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="validation"></span>
                    </div>
                </div>

                <button type="submit" class="auth-submit">Create account</button>
            </form>

            <div class="auth-note">
                <i class="bi bi-info-circle me-1"></i>
                Your account will be reviewed by an administrator. You'll receive an email once it's approved.
            </div>

            <div class="auth-alt">
                Already have an account? <a href="/Login">Sign in</a>
            </div>
        </div>
    </section>

    <!-- Showcase column -->
    <aside class="auth-showcase">
        <div>
            <span class="stamp">Adventist University of Central Africa</span>
            <h1>Built for the way you actually move around campus.</h1>
            <p class="lead">Skip the guesswork. Find your lecturer. Book a room. Read what matters. Then get on with your day.</p>

            <div class="auth-quote">
                "It finally feels like someone designed a schedule for humans, not for spreadsheets."
                <div class="auth-quote-attrib">— A student, probably</div>
            </div>
        </div>
        <div class="footnote">© @DateTime.Now.Year AUCA Pulse</div>
    </aside>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
