@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong · AUCA Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: #f7f8fa; min-height: 100vh;">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <div class="mb-3" style="font-size: 3.5rem; color: #ef4444;">
                        <i class="bi bi-exclamation-octagon"></i>
                    </div>
                    <h2 class="mb-2">Something went wrong</h2>
                    <p class="text-muted mb-4">
                        We hit an unexpected problem processing your request. The team has been notified.
                        Please try again, and if it keeps happening, contact support.
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="/Dashboard" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i>Back to Dashboard
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-secondary">
                            Go Back
                        </button>
                    </div>
                    @if (Model.ShowRequestId)
                    {
                        <p class="text-muted small mt-4 mb-0">
                            Reference: <code>@Model.RequestId</code>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
