@page
@model AUCAPulse.Pages.PasswordResetsModel
@{
    ViewData["Title"] = "Password Reset Requests";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Password Reset Requests</h2>
        <span class="badge bg-info fs-6">@Model.Requests.Count Pending</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Requests.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No pending password reset requests.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" data-paginate="5">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Reason</th>
                                <th>Requested</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.Requests)
                            {
                                <tr>
                                    <td>@request.UserName</td>
                                    <td>@request.UserEmail</td>
                                    <td>@request.Reason</td>
                                    <td>@request.RequestedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @if (request.Status == "PENDING")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (request.Status == "APPROVED")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                    </td>
                                    <td>
                                        @if (request.Status == "PENDING")
                                        {
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="requestId" value="@request.Id" />
                                                <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm me-2">
                                                    <i class="bi bi-check-circle me-1"></i>Approve
                                                </button>
                                                <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-x-circle me-1"></i>Reject
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Processed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
