@page "/OfficeManagement"
@model AUCAPulse.Pages.OfficeManagementModel
@{ ViewData["Title"] = "Office Management"; }

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-building"></i> Office Management</h2>
            <p class="text-muted small">Manage offices in the AUCA Pulse system</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-success btn-lg" data-bs-toggle="modal" data-bs-target="#addOfficeModal">
                <i class="bi bi-plus-circle"></i> Add New Office
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted small">Total Offices</h6>
                    <h3 class="fw-bold text-primary">@Model.Offices.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted small">Assigned</h6>
                    <h3 class="fw-bold text-success">@Model.Offices.Count(o => o.StaffUserId.HasValue)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted small">Unassigned</h6>
                    <h3 class="fw-bold text-warning">@Model.Offices.Count(o => !o.StaffUserId.HasValue)</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">All Offices</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Offices.Count == 0)
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle"></i> No offices found. <a href="#addOfficeModal" data-bs-toggle="modal">Create one</a>.
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Office Name</th>
                            <th>Number</th>
                            <th>Building</th>
                            <th>Floor</th>
                            <th>Department</th>
                            <th>Assigned</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var office in Model.Offices)
                        {
                            <tr>
                                <td><strong>@office.OfficeName</strong></td>
                                <td><span class="badge bg-secondary">@office.OfficeNumber</span></td>
                                <td>@office.Building</td>
                                <td>@(office.Floor ?? "N/A")</td>
                                <td>@(office.Department ?? "N/A")</td>
                                <td>
                                    <span class="badge @(office.StaffUserId.HasValue ? "bg-success" : "bg-secondary")">
                                        @(office.StaffUserId.HasValue ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editOfficeModal" onclick="loadEditForm(@office.Id, '@office.OfficeName', '@office.OfficeNumber', '@office.Building', '@(office.Floor ?? "")', '@(office.Department ?? "")')">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-officeId="@office.Id" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this office?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<!-- Add Office Modal -->
<div class="modal fade" id="addOfficeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Add New Office</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Office Name *</label>
                        <input type="text" class="form-control" name="CreateOfficeRequest.OfficeName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Office Number *</label>
                        <input type="text" class="form-control" name="CreateOfficeRequest.OfficeNumber" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Building</label>
                        <input type="text" class="form-control" name="CreateOfficeRequest.Building">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Floor</label>
                            <input type="text" class="form-control" name="CreateOfficeRequest.Floor">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone Ext</label>
                            <input type="text" class="form-control" name="CreateOfficeRequest.PhoneExtension">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" name="CreateOfficeRequest.Department">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Office Modal -->
<div class="modal fade" id="editOfficeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Office</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" id="editOfficeId" name="officeId">
                    <div class="mb-3">
                        <label class="form-label">Office Name *</label>
                        <input type="text" class="form-control" id="editOfficeName" name="EditOfficeRequest.OfficeName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Office Number *</label>
                        <input type="text" class="form-control" id="editOfficeNumber" name="EditOfficeRequest.OfficeNumber" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Building</label>
                        <input type="text" class="form-control" id="editBuilding" name="EditOfficeRequest.Building">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Floor</label>
                            <input type="text" class="form-control" id="editFloor" name="EditOfficeRequest.Floor">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone Ext</label>
                            <input type="text" class="form-control" id="editPhoneExt" name="EditOfficeRequest.PhoneExtension">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="editDepartment" name="EditOfficeRequest.Department">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function loadEditForm(officeId, officeName, officeNumber, building, floor, department) {
        document.getElementById('editOfficeId').value = officeId;
        document.getElementById('editOfficeName').value = officeName;
        document.getElementById('editOfficeNumber').value = officeNumber;
        document.getElementById('editBuilding').value = building;
        document.getElementById('editFloor').value = floor;
        document.getElementById('editDepartment').value = department;
    }
</script>

<style>
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .badge { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
    .card { border: none; border-radius: 0.5rem; }
</style>

