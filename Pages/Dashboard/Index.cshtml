@page
@model AUCAPulse.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard - ACPulse";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6">Welcome back, @Model.UserName! 👋</h1>
            <p class="text-muted">@Model.UserRole Dashboard</p>
        </div>
    </div>

    @if (Model.UserRole == "ADMIN")
    {
        <!-- Admin Dashboard -->
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Total Users</h6>
                                <h3 class="mb-0">@Model.TotalUsers</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded">
                                <i class="bi bi-people fs-3 text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Pending Requests</h6>
                                <h3 class="mb-0">@Model.PendingRequests</h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded">
                                <i class="bi bi-clock-history fs-3 text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Available Rooms</h6>
                                <h3 class="mb-0">@Model.AvailableRooms</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded">
                                <i class="bi bi-door-open fs-3 text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Active Lecturers</h6>
                                <h3 class="mb-0">@Model.ActiveLecturers</h3>
                            </div>
                            <div class="bg-info bg-opacity-10 p-3 rounded">
                                <i class="bi bi-person-badge fs-3 text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="/VerificationRequests" class="btn btn-outline-primary text-start">
                                <i class="bi bi-check-circle me-2"></i> Review Verification Requests
                            </a>
                            <a href="/UserManagement" class="btn btn-outline-primary text-start">
                                <i class="bi bi-people me-2"></i> Manage Users
                            </a>
                            <a href="/PasswordResets" class="btn btn-outline-primary text-start">
                                <i class="bi bi-key me-2"></i> Password Reset Requests
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Recent Activity</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">No recent activity</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.UserRole == "LECTURER")
    {
        <!-- Lecturer Dashboard -->
        <div class="row g-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2 d-md-flex">
                            <a href="/Schedule" class="btn btn-primary">
                                <i class="bi bi-calendar me-2"></i> View Schedule
                            </a>
                            <a href="/Rooms" class="btn btn-outline-primary">
                                <i class="bi bi-door-open me-2"></i> Find Room
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.UserRole == "STUDENT")
    {
        <!-- Student Dashboard -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Find Lecturers</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Search for lecturers and check their availability</p>
                        <a href="/Lecturers" class="btn btn-primary">
                            <i class="bi bi-search me-2"></i> Search Lecturers
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Available Rooms</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Find available rooms for study or meetings</p>
                        <a href="/Rooms" class="btn btn-primary">
                            <i class="bi bi-door-open me-2"></i> View Rooms
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-broadcast me-2"></i>Lecturer Locations — Right Now</h5>
                <small class="text-muted">Auto-computed from schedule, status, and office</small>
            </div>
            <div class="card-body">
                @if (!Model.LecturerLocations.Any())
                {
                    <p class="text-muted mb-0">No lecturers to show yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" data-paginate="5">
                            <thead>
                                <tr>
                                    <th>Lecturer</th>
                                    <th>Status</th>
                                    <th>Location</th>
                                    <th>Course</th>
                                    <th>Until</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var loc in Model.LecturerLocations)
                            {
                                string badge = loc.Status switch
                                {
                                    "IN_CLASS" => "bg-danger",
                                    "IN_OFFICE" => "bg-success",
                                    "AVAILABLE" => "bg-success",
                                    "IN_MEETING" => "bg-warning text-dark",
                                    "AWAY" => "bg-secondary",
                                    "UNAVAILABLE" => "bg-dark",
                                    _ => "bg-light text-dark"
                                };
                                string icon = loc.Status switch
                                {
                                    "IN_CLASS" => "bi-easel",
                                    "IN_OFFICE" => "bi-building-check",
                                    "AVAILABLE" => "bi-check-circle",
                                    "IN_MEETING" => "bi-people",
                                    "AWAY" => "bi-box-arrow-right",
                                    _ => "bi-question-circle"
                                };
                                <tr>
                                    <td>
                                        <strong>@loc.LecturerName</strong>
                                        @if (!string.IsNullOrWhiteSpace(loc.Department))
                                        {
                                            <br /><small class="text-muted">@loc.Department</small>
                                        }
                                    </td>
                                    <td><span class="badge @badge"><i class="bi @icon me-1"></i>@loc.Status.Replace('_', ' ')</span></td>
                                    <td>@loc.LocationLabel</td>
                                    <td>@(string.IsNullOrWhiteSpace(loc.CourseInfo) ? "-" : loc.CourseInfo)</td>
                                    <td>@(string.IsNullOrWhiteSpace(loc.UntilTime) ? "-" : loc.UntilTime)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Staff Dashboard -->
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">My Office</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Manage your office status and availability</p>
                        <a href="/Profile" class="btn btn-primary">
                            <i class="bi bi-building me-2"></i> View Office
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Campus Resources</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Access rooms and facilities</p>
                        <a href="/Rooms" class="btn btn-primary">
                            <i class="bi bi-door-open me-2"></i> View Rooms
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
