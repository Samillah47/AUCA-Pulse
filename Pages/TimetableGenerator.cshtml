@page
@model AUCAPulse.Pages.TimetableGeneratorModel
@{
    ViewData["Title"] = "Generate Timetable";
    var dayOrder = new[] { "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY" };
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="bi bi-calendar-week me-2"></i>Generate Timetable (Round Robin)</h2>

    <div class="alert alert-info">
        <strong>How it works:</strong> This generator uses a Round Robin algorithm to distribute
        course assignments across time slots and rooms for the selected semester, avoiding
        lecturer conflicts and room double-bookings.
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="card mb-4">
        <div class="card-header"><strong>Generation Parameters</strong></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Generate" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Semester *</label>
                    <select asp-for="SemesterId" class="form-select" required>
                        <option value="">-- Select Semester --</option>
                        @foreach (var s in Model.Semesters)
                        {
                            <option value="@s.Id">@s.Name @(s.IsCurrent ? "(Current)" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Hour</label>
                    <input asp-for="StartHour" type="number" min="0" max="23" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Hour</label>
                    <input asp-for="EndHour" type="number" min="1" max="24" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Slot (minutes)</label>
                    <input asp-for="SlotDurationMinutes" type="number" min="30" max="240" step="30" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="ReplaceExisting" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Replace existing</label>
                    </div>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-play-fill me-1"></i>Generate Timetable
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Result != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-bg-primary"><div class="card-body">
                    <div class="small">Total Assignments</div>
                    <h3>@Model.Result.TotalAssignments</h3>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-bg-success"><div class="card-body">
                    <div class="small">Scheduled</div>
                    <h3>@Model.Result.ScheduledCount</h3>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-bg-warning"><div class="card-body">
                    <div class="small">Unscheduled</div>
                    <h3>@Model.Result.UnscheduledCount</h3>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card text-bg-secondary"><div class="card-body">
                    <div class="small">Semester</div>
                    <h5 class="mb-0">@Model.Result.SemesterName</h5>
                </div></div>
            </div>
        </div>

        @if (Model.Result.Unscheduled.Any())
        {
            <div class="card mb-4 border-warning">
                <div class="card-header bg-warning text-dark">
                    <strong>Unscheduled Assignments</strong>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead><tr><th>Lecturer</th><th>Course</th><th>Reason</th></tr></thead>
                        <tbody>
                        @foreach (var u in Model.Result.Unscheduled)
                        {
                            <tr>
                                <td>@u.LecturerName</td>
                                <td><strong>@u.CourseCode</strong> — @u.CourseName</td>
                                <td class="text-muted">@u.Reason</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header"><strong>Generated Timetable</strong></div>
            <div class="card-body">
                @{
                    var grouped = Model.Result.Scheduled
                        .GroupBy(x => x.DayOfWeek)
                        .OrderBy(g => Array.IndexOf(dayOrder, g.Key));
                }
                @foreach (var dayGroup in grouped)
                {
                    <h5 class="mt-3">@dayGroup.Key</h5>
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Course</th>
                                <th>Lecturer</th>
                                <th>Room</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in dayGroup.OrderBy(e => e.StartTime))
                            {
                                <tr>
                                    <td>@entry.StartTime - @entry.EndTime</td>
                                    <td><strong>@entry.CourseCode</strong> — @entry.CourseName</td>
                                    <td>@entry.LecturerName</td>
                                    <td><span class="badge bg-info text-dark">@entry.RoomNumber</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (!Model.Result.Scheduled.Any())
                {
                    <div class="text-muted">No schedules were generated.</div>
                }
            </div>
        </div>
    }
</div>
