@page "/Lecturers/{id:int}"
@model AUCAPulse.Pages.LecturerDetailModel
@{
    ViewData["Title"] = Model.Lecturer?.Name ?? "Lecturer";

    var dayOrder = new[] { "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" };
    var schedByDay = Model.Schedule
        .GroupBy(s => (s.DayOfWeek ?? string.Empty).ToUpperInvariant())
        .OrderBy(g => Array.IndexOf(dayOrder, g.Key) is int idx && idx >= 0 ? idx : int.MaxValue);

    var assignByCourse = Model.Assignments
        .GroupBy(a => new { a.CourseId, a.CourseCode, a.CourseName, a.Credits })
        .OrderBy(g => g.Key.CourseCode);

    var cancelledToday = Model.Schedule
        .Where(s => s.CancelledOn.HasValue && s.CancelledOn.Value.Date == DateTime.UtcNow.Date)
        .ToList();
}

<div class="container-fluid">
    <a href="/Lecturers" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Back to Lecturers
    </a>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Lecturer != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex align-items-start gap-3">
                <div style="width:52px;height:52px;border-radius:12px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;flex-shrink:0;">
                    <i class="bi bi-person fs-3"></i>
                </div>
                <div class="flex-grow-1">
                    <h2 class="mb-1">@Model.Lecturer.Name</h2>
                    <div class="text-muted small">
                        <i class="bi bi-envelope me-1"></i>@Model.Lecturer.Email
                        @if (!string.IsNullOrWhiteSpace(Model.Lecturer.Department))
                        {
                            <span class="ms-3"><i class="bi bi-building me-1"></i>@Model.Lecturer.Department</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Lecturer.PhoneNumber))
                        {
                            <span class="ms-3"><i class="bi bi-telephone me-1"></i>@Model.Lecturer.PhoneNumber</span>
                        }
                    </div>
                </div>
                <div class="text-end">
                    @{
                        string statusBadgeClass = Model.CurrentStatus switch
                        {
                            "IN_CLASS"    => "bg-danger",
                            "IN_OFFICE"   => "bg-success",
                            "AVAILABLE"   => "bg-success",
                            "IN_MEETING"  => "bg-warning text-dark",
                            "AWAY"        => "bg-secondary",
                            "UNAVAILABLE" => "bg-dark",
                            _             => "bg-light text-dark"
                        };
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentStatus))
                    {
                        <div class="mb-1">
                            <span class="badge @statusBadgeClass fs-6">
                                <i class="bi bi-circle-fill me-1" style="font-size:7px;"></i>@Model.CurrentStatus.Replace('_', ' ')
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentLocationLabel))
                        {
                            <div class="small text-muted">@Model.CurrentLocationLabel</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentUntilTime))
                        {
                            <div class="small text-muted">until @Model.CurrentUntilTime</div>
                        }
                    }
                    <div class="mt-1">
                        <span class="badge bg-primary">@Model.Assignments.Count course group@(Model.Assignments.Count == 1 ? "" : "s")</span>
                        <span class="badge bg-secondary">@Model.Schedule.Count class@(Model.Schedule.Count == 1 ? "" : "es") / week</span>
                    </div>
                </div>
            </div>
        </div>

        @if (cancelledToday.Any())
        {
            <div class="alert alert-warning mb-4">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                    <div class="flex-grow-1">
                        <strong>@cancelledToday.Count class@(cancelledToday.Count == 1 ? "" : "es") cancelled today</strong>
                        <ul class="mb-0 mt-1 small">
                            @foreach (var c in cancelledToday)
                            {
                                <li>
                                    <strong>@c.CourseCode</strong> @c.CourseName ·
                                    @c.StartTime.Substring(0, Math.Min(5, c.StartTime.Length))-@c.EndTime.Substring(0, Math.Min(5, c.EndTime.Length))
                                    @if (!string.IsNullOrWhiteSpace(c.RoomNumber))
                                    {
                                        <span> · Room @c.RoomNumber</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.CancellationReason))
                                    {
                                        <span class="text-muted"> — @c.CancellationReason</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Courses taught -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-book me-2"></i>Courses taught</h5>
                        <small class="text-muted">Grouped by course, one row per group</small>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.Assignments.Any())
                        {
                            <div class="empty-state">
                                <i class="bi bi-journal-x"></i>
                                <h5>No course assignments</h5>
                                <div>Admin hasn't assigned any courses to this lecturer yet.</div>
                            </div>
                        }
                        else
                        {
                            @foreach (var grp in assignByCourse)
                            {
                                <div class="px-3 py-3" style="border-bottom:1px solid var(--border);">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <strong>@grp.Key.CourseCode</strong> — @grp.Key.CourseName
                                        </div>
                                        <small class="text-muted">@grp.Key.Credits cr</small>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @foreach (var a in grp.OrderBy(x => x.GroupName).ThenBy(x => x.SemesterName))
                                        {
                                            <span class="badge bg-primary">Group @a.GroupName</span>
                                            <span class="badge bg-secondary">@a.SemesterName</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Weekly schedule -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-calendar-week me-2"></i>Weekly schedule</h5>
                        <small class="text-muted">From the generated timetable</small>
                    </div>
                    <div class="card-body">
                        @if (!Model.Schedule.Any())
                        {
                            <div class="empty-state">
                                <i class="bi bi-calendar-x"></i>
                                <h5>No classes scheduled</h5>
                                <div>The timetable hasn't been generated for this lecturer yet.</div>
                            </div>
                        }
                        else
                        {
                            @foreach (var dayGroup in schedByDay)
                            {
                                <h6 class="mt-2 mb-2 text-muted">@dayGroup.Key</h6>
                                <div class="table-responsive mb-3">
                                    <table class="table table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 130px;">Time</th>
                                                <th>Course</th>
                                                <th style="width: 100px;">Group</th>
                                                <th style="width: 100px;">Room</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var e in dayGroup.OrderBy(x => x.StartTime))
                                        {
                                            <tr>
                                                <td>
                                                    @e.StartTime.Substring(0, Math.Min(5, e.StartTime.Length))
                                                    -
                                                    @e.EndTime.Substring(0, Math.Min(5, e.EndTime.Length))
                                                </td>
                                                <td>
                                                    <strong>@e.CourseCode</strong>
                                                    @if (!string.IsNullOrWhiteSpace(e.CourseName))
                                                    {
                                                        <span class="text-muted"> — @e.CourseName</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(e.GroupName))
                                                    {
                                                        <span class="badge bg-primary">Group @e.GroupName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(e.RoomNumber))
                                                    {
                                                        <span class="badge bg-secondary">@e.RoomNumber</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
