@page
@model AUCAPulse.Pages.Student.TimetableModel
@{
    ViewData["Title"] = "My Timetable";
    Layout = "_StudentLayout";
    var dayOrder = new[] { "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SUNDAY" };

    // One row per distinct start time — multi-credit classes would otherwise
    // produce duplicate rows (same start, different end).
    var startTimes = Model.Schedules
        .Select(s => s.StartTime)
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

<div class="mb-3">
    <h1 class="mb-1">My Timetable</h1>
    <div class="text-muted">@(string.IsNullOrWhiteSpace(Model.SemesterName) ? "Current semester" : Model.SemesterName)</div>
</div>

@if (!Model.Schedules.Any())
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <h5>No timetable available yet</h5>
            <div>Once classes are scheduled for the current semester, they'll appear here.</div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th style="width: 110px;">Time</th>
                            @foreach (var d in dayOrder)
                            {
                                <th>@d</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var startTime in startTimes)
                    {
                        <tr>
                            <td class="small text-muted">
                                @startTime.Substring(0, Math.Min(5, startTime.Length))
                            </td>
                            @foreach (var d in dayOrder)
                            {
                                var entries = Model.Schedules.Where(e => e.DayOfWeek == d && e.StartTime == startTime).ToList();
                                <td>
                                    @foreach (var e in entries)
                                    {
                                        <div class="mb-2 p-2 rounded" style="background:var(--accent-soft);border-left:3px solid var(--accent);">
                                            <div class="small text-muted">
                                                @e.StartTime.Substring(0, Math.Min(5, e.StartTime.Length)) - @e.EndTime.Substring(0, Math.Min(5, e.EndTime.Length))
                                            </div>
                                            <div class="small" style="font-weight:600;">@e.CourseCode @e.CourseName</div>
                                            <div class="small text-muted">@e.LecturerName</div>
                                            <div class="small mt-1 d-flex gap-1 flex-wrap">
                                                @if (!string.IsNullOrEmpty(e.GroupName))
                                                {
                                                    <span class="badge bg-primary">Group @e.GroupName</span>
                                                }
                                                @if (!string.IsNullOrEmpty(e.RoomNumber))
                                                {
                                                    <span class="badge bg-secondary">@e.RoomNumber</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
