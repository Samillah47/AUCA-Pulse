@page "/Student/MyAppointments"
@model AUCAPulse.Pages.Student.MyAppointmentsModel
@{ ViewData["Title"] = "My Appointments"; }

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-calendar-check"></i> My Appointments</h2>
            <p class="text-muted small">Book office visits and track appointment approval status</p>
        </div>
        <div class="col-md-4 text-end">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#requestOfficeVisitModal">
                <i class="bi bi-calendar-plus"></i> Book Office Visit
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="modal fade" id="requestOfficeVisitModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-building"></i> Request New Office Visit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="RequestNew">
                    <div class="modal-body">
                        <input type="hidden" name="tab" value="@Model.FilterTab" />
                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

                        <div class="mb-3">
                            <label class="form-label">Choose Office</label>
                            <select asp-for="SelectedOfficeId" class="form-select" id="officeSelect" required>
                                <option value="">-- Select an office --</option>
                                @foreach (var office in Model.OfficeOptions)
                                {
                                    var display = $"{office.OfficeName} ({office.OfficeNumber})";
                                    if (!string.IsNullOrWhiteSpace(office.Building))
                                    {
                                        display += $" - {office.Building}";
                                    }

                                    <option value="@office.OfficeId"
                                            data-office-name="@office.OfficeName"
                                            data-office-number="@office.OfficeNumber"
                                            data-staff-name="@(office.StaffName ?? "Unassigned")"
                                            data-staff-email="@(office.StaffEmail ?? "N/A")"
                                            data-department="@(office.Department ?? "N/A")"
                                            data-status="@office.CurrentStatus"
                                            data-bookable="@(office.IsBookable ? "true" : "false")">
                                        @display
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="card bg-light mb-3" id="officeDetailsCard" style="display:none;">
                            <div class="card-body">
                                <h6 class="mb-2" id="officeNameText"></h6>
                                <div class="small text-muted mb-2" id="staffMetaText"></div>
                                <div>
                                    <span class="badge" id="officeStatusBadge">UNAVAILABLE</span>
                                </div>
                                <div class="small mt-2 text-danger" id="availabilityWarning" style="display:none;">
                                    Staff not currently available. Please choose another office or try later.
                                </div>
                            </div>
                        </div>

                        <div id="bookingFields" style="display:none;">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Appointment Date</label>
                                    <input asp-for="AppointmentDate" type="date" class="form-control" min="@Model.MinBookingDate" max="@Model.MaxBookingDate" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Appointment Time</label>
                                    <input asp-for="AppointmentTime" type="time" class="form-control" min="08:00" max="17:00" step="900" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Reason</label>
                                <textarea asp-for="AppointmentReason" class="form-control" rows="3" maxlength="500"
                                          placeholder="Describe the help you need from this office."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="submitOfficeVisitBtn" disabled>Send Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <ul class="nav nav-tabs card-header-tabs mb-0" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(Model.FilterTab == "pending" ? "active" : "")" href="/Student/MyAppointments?tab=pending">
                        <i class="bi bi-hourglass-split"></i> Pending
                        <span class="badge bg-secondary ms-2">@Model.PendingAppointments.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.FilterTab == "approved" ? "active" : "")" href="/Student/MyAppointments?tab=approved">
                        <i class="bi bi-check-circle"></i> Approved
                        <span class="badge bg-success ms-2">@Model.ApprovedAppointments.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.FilterTab == "rejected" ? "active" : "")" href="/Student/MyAppointments?tab=rejected">
                        <i class="bi bi-x-circle"></i> Rejected
                        <span class="badge bg-danger ms-2">@Model.RejectedAppointments.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.FilterTab == "completed" ? "active" : "")" href="/Student/MyAppointments?tab=completed">
                        <i class="bi bi-check2-all"></i> Completed
                        <span class="badge bg-info ms-2">@Model.CompletedAppointments.Count</span>
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body p-0">
            @if (Model.PaginatedAppointments.Count == 0)
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle"></i> No appointments in this category.
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Office</th>
                            <th>Staff</th>
                            <th>Date & Time</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-center">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model.PaginatedAppointments)
                        {
                            var status = apt.Status;
                            var badgeClass = status == "APPROVED" ? "bg-success" :
                                            status == "REJECTED" ? "bg-danger" :
                                            status == "COMPLETED" ? "bg-info" :
                                            "bg-secondary";

                            var isUpcoming = apt.AppointmentDate >= DateTime.Now;
                            var timeRemaining = "";
                            if (status == "APPROVED" && isUpcoming)
                            {
                                var timeSpan = apt.AppointmentDate - DateTime.Now;
                                if (timeSpan.TotalHours >= 24)
                                {
                                    timeRemaining = $"{timeSpan.Days}d remaining";
                                }
                                else if (timeSpan.TotalHours >= 1)
                                {
                                    timeRemaining = $"{(int)timeSpan.TotalHours}h remaining";
                                }
                                else
                                {
                                    timeRemaining = $"{(int)timeSpan.TotalMinutes}m remaining";
                                }
                            }

                            <tr>
                                <td><strong>@apt.OfficeName</strong></td>
                                <td>
                                    <div>@apt.StaffName</div>
                                    <small class="text-muted">@apt.StaffEmail</small>
                                </td>
                                <td>
                                    <div>@apt.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@apt.AppointmentDate.ToString("HH:mm")</small>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(apt.Reason) ? "N/A" : apt.Reason)</td>
                                <td>
                                    <span class="badge @badgeClass">@status</span>
                                    @if (!string.IsNullOrEmpty(timeRemaining))
                                    {
                                        <div class="small text-muted mt-1">@timeRemaining</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#detailsModal@apt.Id">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>

                            <div class="modal fade" id="detailsModal@apt.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Appointment Details</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Office</label>
                                                <p>@apt.OfficeName</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Staff Member</label>
                                                <p>@apt.StaffName</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Email</label>
                                                <p>@apt.StaffEmail</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Date</label>
                                                <p>@apt.AppointmentDate.ToString("dddd, MMMM dd, yyyy")</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Time</label>
                                                <p>@apt.AppointmentDate.ToString("HH:mm")</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Reason</label>
                                                <p>@(string.IsNullOrWhiteSpace(apt.Reason) ? "No reason provided" : apt.Reason)</p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Status</label>
                                                <p><span class="badge @badgeClass">@status</span></p>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Requested On</label>
                                                <p>@apt.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light">
                <nav aria-label="Pagination">
                    <ul class="pagination mb-0 justify-content-center">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Student/MyAppointments?tab=@Model.FilterTab&pageNumber=1"><i class="bi bi-chevron-double-left"></i> First</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="/Student/MyAppointments?tab=@Model.FilterTab&pageNumber=@(Model.PageNumber - 1)"><i class="bi bi-chevron-left"></i> Previous</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-double-left"></i> First</span></li>
                            <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i> Previous</span></li>
                        }

                        @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                        {
                            @if (i == Model.PageNumber)
                            {
                                <li class="page-item active"><span class="page-link">@i</span></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="/Student/MyAppointments?tab=@Model.FilterTab&pageNumber=@i">@i</a></li>
                            }
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Student/MyAppointments?tab=@Model.FilterTab&pageNumber=@(Model.PageNumber + 1)">Next <i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="/Student/MyAppointments?tab=@Model.FilterTab&pageNumber=@Model.TotalPages">Last <i class="bi bi-chevron-double-right"></i></a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Next <i class="bi bi-chevron-right"></i></span></li>
                            <li class="page-item disabled"><span class="page-link">Last <i class="bi bi-chevron-double-right"></i></span></li>
                        }
                    </ul>
                </nav>
                <div class="text-center text-muted small mt-2">
                    Page @Model.PageNumber of @Model.TotalPages (showing @Model.PaginatedAppointments.Count of @Model.TotalAppointments)
                </div>
            </div>
        }
    </div>
</div>

<style>
    .card { border: none; border-radius: 0.5rem; }
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .badge { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
    .nav-tabs .nav-link { color: #495057; border-bottom: 2px solid transparent; }
    .nav-tabs .nav-link.active { color: #0d6efd; border-bottom-color: #0d6efd; }
    .pagination { gap: 0.25rem; }
    .page-link { border-radius: 0.25rem; }
</style>

@section Scripts {
<script>
    (function () {
        var officeSelect = document.getElementById('officeSelect');
        var detailsCard = document.getElementById('officeDetailsCard');
        var officeNameText = document.getElementById('officeNameText');
        var staffMetaText = document.getElementById('staffMetaText');
        var statusBadge = document.getElementById('officeStatusBadge');
        var warning = document.getElementById('availabilityWarning');
        var bookingFields = document.getElementById('bookingFields');
        var submitBtn = document.getElementById('submitOfficeVisitBtn');

        function statusClass(status) {
            if (status === 'AVAILABLE') return 'bg-success';
            if (status === 'IN_CLASS') return 'bg-info';
            if (status === 'IN_MEETING') return 'bg-warning text-dark';
            if (status === 'AWAY') return 'bg-secondary';
            return 'bg-danger';
        }

        function updateSelection() {
            var option = officeSelect.options[officeSelect.selectedIndex];
            if (!option || !option.value) {
                detailsCard.style.display = 'none';
                bookingFields.style.display = 'none';
                submitBtn.disabled = true;
                return;
            }

            var officeName = option.getAttribute('data-office-name') || '';
            var officeNumber = option.getAttribute('data-office-number') || '';
            var staffName = option.getAttribute('data-staff-name') || 'Unassigned';
            var staffEmail = option.getAttribute('data-staff-email') || 'N/A';
            var department = option.getAttribute('data-department') || 'N/A';
            var status = option.getAttribute('data-status') || 'UNAVAILABLE';
            var bookable = option.getAttribute('data-bookable') === 'true';

            detailsCard.style.display = '';
            officeNameText.textContent = officeName + ' (' + officeNumber + ')';
            staffMetaText.textContent = staffName + ' | ' + staffEmail + ' | Department: ' + department;
            statusBadge.textContent = status;
            statusBadge.className = 'badge ' + statusClass(status);

            warning.style.display = bookable ? 'none' : '';
            bookingFields.style.display = bookable ? '' : 'none';
            submitBtn.disabled = !bookable;
        }

        officeSelect.addEventListener('change', updateSelection);
        updateSelection();
    })();
</script>
}
