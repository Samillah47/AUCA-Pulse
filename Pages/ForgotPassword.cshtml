@page
@model AUCAPulse.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password · AUCA Pulse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: #f7f8fa; min-height: 100vh;">
<div class="container" style="max-width: 440px; padding-top: 80px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h3 class="mb-1">Forgot your password?</h3>
            <p class="text-muted mb-4">Enter your email and we'll send a reset link.</p>

            @if (Model.Submitted)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-1"></i>
                    If that email is registered, we've sent reset instructions. Please check your inbox.
                </div>
                <a href="/Login" class="btn btn-outline-secondary w-100">Back to Login</a>
            }
            else
            {
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required autofocus />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-2">Send reset link</button>
                    <a href="/Login" class="btn btn-link w-100">Back to Login</a>
                </form>
            }
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/toast.js" asp-append-version="true"></script>
<partial name="_Toasts" />
</body>
</html>
