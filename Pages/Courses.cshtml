@page
@model AUCAPulse.Pages.CoursesModel
@{
    ViewData["Title"] = "Courses";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-book me-2"></i>Courses</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCourseModal">
            <i class="bi bi-plus-circle me-1"></i> Add Course
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Credits</th>
                            <th>Department</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Courses.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">No courses yet. Add the first one.</td></tr>
                        }
                        @foreach (var c in Model.Courses)
                        {
                            <tr>
                                <td><strong>@c.CourseCode</strong></td>
                                <td>@c.CourseName</td>
                                <td>@c.Credits</td>
                                <td>@(c.Department ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(c.Description) ? "-" : c.Description)</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="courseId" value="@c.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm" onclick="return confirm('Delete this course?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Course Modal -->
<div class="modal fade" id="addCourseModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Course Code *</label>
                        <input asp-for="NewCourse.CourseCode" class="form-control" placeholder="e.g. CS301" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Course Name *</label>
                        <input asp-for="NewCourse.CourseName" class="form-control" placeholder="e.g. Data Structures" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Credits</label>
                        <input asp-for="NewCourse.Credits" type="number" class="form-control" min="1" max="12" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <input asp-for="NewCourse.Department" class="form-control" placeholder="e.g. Computer Science" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="NewCourse.Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Course</button>
                </div>
            </div>
        </form>
    </div>
</div>
