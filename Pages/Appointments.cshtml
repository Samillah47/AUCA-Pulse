@page "/Appointments"
@model AUCAPulse.Pages.AppointmentsModel
@{ ViewData["Title"] = "Appointments"; }

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-calendar-check"></i> Appointments</h2>
            <p class="text-muted small">Manage your appointment requests</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Filter Appointments</h5>
        </div>
        <div class="card-body">
            <div class="btn-group" role="group">
                <a href="/Appointments" class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) && string.IsNullOrEmpty(Model.DateFilter) ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-funnel"></i> All
                </a>
                <a href="/Appointments?status=PENDING" class="btn btn-sm @(Model.StatusFilter == "PENDING" ? "btn-warning" : "btn-outline-warning")">
                    <i class="bi bi-hourglass-split"></i> Pending
                </a>
                <a href="/Appointments?status=APPROVED" class="btn btn-sm @(Model.StatusFilter == "APPROVED" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check-circle"></i> Approved
                </a>
                <a href="/Appointments?status=APPROVED&filter=upcoming" class="btn btn-sm @(Model.DateFilter == "upcoming" ? "btn-info" : "btn-outline-info")">
                    <i class="bi bi-calendar-event"></i> Upcoming
                </a>
                <a href="/Appointments?status=COMPLETED" class="btn btn-sm @(Model.StatusFilter == "COMPLETED" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-check2-all"></i> Completed
                </a>
                <a href="/Appointments?status=REJECTED" class="btn btn-sm @(Model.StatusFilter == "REJECTED" ? "btn-danger" : "btn-outline-danger")">
                    <i class="bi bi-x-circle"></i> Rejected
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Your Appointments</h5>
                <span class="badge bg-primary">Total: @Model.TotalAppointments</span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.PaginatedAppointments.Count == 0)
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle"></i> No appointments found.
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student/Staff Name</th>
                            <th>Email</th>
                            <th>Date</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model.PaginatedAppointments)
                        {
                            var status = ((apt as dynamic)?.Status?.ToString() ?? "PENDING").ToUpper();
                            var appointmentDate = (DateTime?)((apt as dynamic)?.AppointmentDate) ?? DateTime.Now;
                            var badgeClass = status == "APPROVED" ? "bg-success" :
                                             status == "REJECTED" ? "bg-danger" :
                                             status == "COMPLETED" ? "bg-info" :
                                             "bg-warning";

                            <tr>
                                <td><strong>@((apt as dynamic)?.StudentName ?? (apt as dynamic)?.StaffName)</strong></td>
                                <td>@((apt as dynamic)?.StudentEmail ?? (apt as dynamic)?.StaffEmail)</td>
                                <td>@appointmentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@((apt as dynamic)?.Reason ?? "N/A")</td>
                                <td>
                                    <span class="badge @badgeClass">@status</span>
                                </td>
                                <td class="text-center">
                                    @if (status == "PENDING")
                                    {
                                        <form method="post" asp-page-handler="Approve" style="display:inline;">
                                            <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                            <input type="hidden" name="dateFilter" value="@Model.DateFilter" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check"></i> Approve
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@((apt as dynamic)?.Id)">
                                            <i class="bi bi-x"></i> Reject
                                        </button>

                                        <div class="modal fade" id="rejectModal@((apt as dynamic)?.Id)" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Reject Appointment</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form method="post" asp-page-handler="Reject">
                                                        <div class="modal-body">
                                                            <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                                            <input type="hidden" name="dateFilter" value="@Model.DateFilter" />

                                                            <label class="form-label">Rejection reason (optional)</label>
                                                            <textarea class="form-control" name="rejectionReason" rows="3" maxlength="500"
                                                                      placeholder="Briefly explain why the request is rejected."></textarea>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Confirm Reject</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (status == "APPROVED" && appointmentDate <= DateTime.Now)
                                    {
                                        <form method="post" asp-page-handler="Complete" style="display:inline;">
                                            <input type="hidden" name="appointmentId" value="@((apt as dynamic)?.Id)" />
                                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                            <input type="hidden" name="dateFilter" value="@Model.DateFilter" />
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-check2-all"></i> Mark Completed
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light">
                <nav aria-label="Pagination">
                    <ul class="pagination mb-0 justify-content-center">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Appointments?pageNumber=1&status=@Model.StatusFilter&filter=@Model.DateFilter"><i class="bi bi-chevron-double-left"></i> First</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="/Appointments?pageNumber=@(Model.PageNumber - 1)&status=@Model.StatusFilter&filter=@Model.DateFilter"><i class="bi bi-chevron-left"></i> Previous</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="bi bi-chevron-double-left"></i> First</span>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link"><i class="bi bi-chevron-left"></i> Previous</span>
                            </li>
                        }

                        @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                        {
                            @if (i == Model.PageNumber)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/Appointments?pageNumber=@i&status=@Model.StatusFilter&filter=@Model.DateFilter">@i</a>
                                </li>
                            }
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Appointments?pageNumber=@(Model.PageNumber + 1)&status=@Model.StatusFilter&filter=@Model.DateFilter">Next <i class="bi bi-chevron-right"></i></a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="/Appointments?pageNumber=@Model.TotalPages&status=@Model.StatusFilter&filter=@Model.DateFilter">Last <i class="bi bi-chevron-double-right"></i></a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Next <i class="bi bi-chevron-right"></i></span>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Last <i class="bi bi-chevron-double-right"></i></span>
                            </li>
                        }
                    </ul>
                </nav>
                <div class="text-center text-muted small mt-2">
                    Page @Model.PageNumber of @Model.TotalPages (showing @Model.PaginatedAppointments.Count of @Model.TotalAppointments)
                </div>
            </div>
        }
    </div>
</div>

<style>
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .badge { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
    .card { border: none; border-radius: 0.5rem; }
    .pagination { gap: 0.25rem; }
    .page-link { border-radius: 0.25rem; }
</style>
