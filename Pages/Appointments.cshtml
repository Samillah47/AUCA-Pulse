@page "/Appointments"
@model AUCAPulse.Pages.AppointmentsModel
@{ ViewData["Title"] = "Appointments"; }

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-calendar-check"></i> Appointments</h2>
            <p class="text-muted small">Manage your appointment requests</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Your Appointments</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Appointments.Count == 0)
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle"></i> No appointments found.
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student/Staff Name</th>
                            <th>Email</th>
                            <th>Date</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model.Appointments)
                        {
                            <tr>
                                <td><strong>@((apt as dynamic)?.StudentName ?? (apt as dynamic)?.StaffName)</strong></td>
                                <td>@((apt as dynamic)?.StudentEmail ?? (apt as dynamic)?.StaffEmail)</td>
                                <td>@((apt as dynamic)?.AppointmentDate.ToString("MMM dd, yyyy HH:mm"))</td>
                                <td>@((apt as dynamic)?.Reason ?? "N/A")</td>
                                <td>
                                    @{
                                        var status = ((apt as dynamic)?.Status?.ToString() ?? "PENDING").ToUpper();
                                        var badgeClass = status == "APPROVED" ? "bg-success" : 
                                                         status == "REJECTED" ? "bg-danger" :
                                                         status == "COMPLETED" ? "bg-info" :
                                                         "bg-warning";
                                    }
                                    <span class="badge @badgeClass">@status</span>
                                </td>
                                <td class="text-center">
                                    @if (status == "PENDING")
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-appointmentId="@((apt as dynamic)?.Id)" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check"></i> Approve
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Reject" asp-route-appointmentId="@((apt as dynamic)?.Id)" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-x"></i> Reject
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover { background-color: #f8f9fa; }
    .badge { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
    .card { border: none; border-radius: 0.5rem; }
</style>

