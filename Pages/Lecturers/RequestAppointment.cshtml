@page "/Lecturers/RequestAppointment"
@model AUCAPulse.Pages.Lecturers.RequestAppointmentModel
@{ ViewData["Title"] = "Request Appointment"; }

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary"><i class="bi bi-calendar-plus"></i> Request Appointment</h2>
            <p class="text-muted small">Schedule a meeting with available staff members</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-8">
                    <input type="text" name="search" class="form-control" placeholder="Search staff by name, email, or department..." value="@Model.SearchQuery">
                </div>
                <div class="col-md-2">
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="showOnlyAvailable" name="showOnlyAvailable" @(Model.ShowOnlyAvailable ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label" for="showOnlyAvailable">Show Only Available</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Staff List -->
    <div class="row">
        @if (Model.AvailableStaff.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    @if (string.IsNullOrEmpty(Model.SearchQuery) && !Model.ShowOnlyAvailable)
                    {
                        <span>No staff members available yet. Please check back later.</span>
                    }
                    else
                    {
                        <span>No staff members match your search criteria.</span>
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var staff in Model.AvailableStaff)
            {
                var status = (staff as dynamic)?.CurrentStatus?.ToString() ?? "AVAILABLE";
                var statusBadgeClass = status == "AVAILABLE" ? "bg-success" :
                                      status == "IN_CLASS" ? "bg-info" :
                                      status == "IN_MEETING" ? "bg-warning" :
                                      status == "AWAY" ? "bg-secondary" :
                                      "bg-danger";
                var isAvailable = status == "AVAILABLE";

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">@((staff as dynamic)?.Name)</h5>
                                    <p class="text-muted small mb-0">@((staff as dynamic)?.Email)</p>
                                </div>
                                <span class="badge @statusBadgeClass">@status</span>
                            </div>

                            @if (!string.IsNullOrEmpty((staff as dynamic)?.Department))
                            {
                                <p class="card-text small mb-2">
                                    <strong><i class="bi bi-briefcase"></i> Department:</strong> @((staff as dynamic)?.Department)
                                </p>
                            }

                            @if ((staff as dynamic)?.OfficeName != null)
                            {
                                <p class="card-text small mb-3">
                                    <strong><i class="bi bi-building"></i> Office:</strong> @((staff as dynamic)?.OfficeName)
                                </p>
                            }
                            else
                            {
                                <p class="card-text small mb-3 text-muted">
                                    <i class="bi bi-building"></i> <em>No office assigned yet</em>
                                </p>
                            }

                            @if (isAvailable)
                            {
                                <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#appointmentModal@((staff as dynamic)?.Id)">
                                    <i class="bi bi-calendar-plus"></i> Request Appointment
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary w-100" disabled title="Staff is currently @status">
                                    <i class="bi bi-lock"></i> Currently @status
                                </button>
                                <small class="text-muted d-block mt-2 text-center">Cannot schedule when @status.ToLower()</small>
                            }
                        </div>
                    </div>
                </div>

                <!-- Appointment Request Modal -->
                @if (isAvailable)
                {
                    <div class="modal fade" id="appointmentModal@((staff as dynamic)?.Id)" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        <i class="bi bi-calendar-plus"></i> Request Appointment with @((staff as dynamic)?.Name)
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form method="post" asp-page-handler="Request">
                                    <div class="modal-body">
                                        <input type="hidden" name="staffId" value="@((staff as dynamic)?.Id)">

                                        <div class="mb-3">
                                            <label class="form-label">Staff Name</label>
                                            <input type="text" class="form-control" value="@((staff as dynamic)?.Name)" disabled>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Current Status</label>
                                            <p>
                                                <span class="badge @statusBadgeClass">@status</span>
                                            </p>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Appointment Date</label>
                                            <input type="date" class="form-control" name="appointmentDate" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Appointment Time</label>
                                            <input type="time" class="form-control" name="appointmentTime" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Reason for Meeting</label>
                                            <textarea class="form-control" name="reason" rows="3" placeholder="Describe the purpose of this meeting..."></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Submit Request</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

<style>
    .card { border: none; border-radius: 0.5rem; }
    .badge { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
    .modal-dialog { max-width: 500px; }
</style>

<script>
    // Set minimum date to today for date picker
    document.addEventListener('DOMContentLoaded', function() {
        const today = new Date().toISOString().split('T')[0];
        const dateInputs = document.querySelectorAll('input[type="date"]');
        dateInputs.forEach(input => {
            input.min = today;
        });
    });
</script>




