@page
@model AUCAPulse.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password · AUCA Pulse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: #f7f8fa; min-height: 100vh;">
<div class="container" style="max-width: 480px; padding-top: 60px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h3 class="mb-1">Choose a new password</h3>
            <p class="text-muted mb-4">Your new password must be at least 6 characters long.</p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form method="post">
                <input asp-for="Token" type="hidden" />
                <div class="mb-3">
                    <label class="form-label">New password</label>
                    <input asp-for="NewPassword" type="password" class="form-control" id="newPw" required minlength="6" autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPw" required minlength="6" />
                    <div id="matchHint" class="form-text"></div>
                </div>
                <button type="submit" class="btn btn-primary w-100 mb-2" id="submitBtn">Update password</button>
                <a href="/Login" class="btn btn-link w-100">Back to Login</a>
            </form>
        </div>
    </div>
</div>
<script>
    (function(){
        var pw = document.getElementById('newPw');
        var cpw = document.getElementById('confirmPw');
        var hint = document.getElementById('matchHint');
        var btn = document.getElementById('submitBtn');
        function check() {
            if (!cpw.value) { hint.textContent = ''; hint.className = 'form-text'; return; }
            if (pw.value === cpw.value) {
                hint.textContent = 'Passwords match.';
                hint.className = 'form-text text-success';
            } else {
                hint.textContent = "Passwords don't match yet.";
                hint.className = 'form-text text-danger';
            }
        }
        pw.addEventListener('input', check);
        cpw.addEventListener('input', check);
    })();
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
