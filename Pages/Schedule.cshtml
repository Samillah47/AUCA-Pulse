@page
@model AUCAPulse.Pages.ScheduleModel
@{
    ViewData["Title"] = "My Schedule";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6">My Lecture Schedule</h1>
            <p class="text-muted">View and manage your teaching schedule</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
        </div>
    }

    <!-- Current Status Card -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Current Status</h5>
                    @if (!string.IsNullOrEmpty(Model.CurrentStatus))
                    {
                        <span class="badge @GetStatusBadgeClass(Model.CurrentStatus) fs-5">
                            <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>
                            @Model.CurrentStatus
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-5">No Status Set</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Schedule Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Weekly Schedule</h5>
        </div>
        <div class="card-body">
            @if (Model.Schedules != null && Model.Schedules.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" data-paginate="5">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>Time</th>
                                <th>Course</th>
                                <th>Room</th>
                                <th>Semester</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.Schedules.OrderBy(s => GetDayOrder(s.DayOfWeek)))
                            {
                                <tr>
                                    <td><strong>@schedule.DayOfWeek</strong></td>
                                    <td>@schedule.StartTime - @schedule.EndTime</td>
                                    <td>@schedule.CourseName</td>
                                    <td>
                                        <span class="badge bg-primary">@schedule.RoomNumber</span>
                                    </td>
                                    <td>@schedule.SemesterName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3">No schedule available</h5>
                    <p class="text-muted">You have no scheduled classes at the moment</p>
                </div>
            }
        </div>
    </div>

    <!-- Today's Classes -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Today's Classes (@DateTime.Now.DayOfWeek)</h5>
        </div>
        <div class="card-body">
            @{
                var todaySchedules = Model.Schedules?.Where(s => s.DayOfWeek.Equals(DateTime.Now.DayOfWeek.ToString(), StringComparison.OrdinalIgnoreCase)).ToList();
            }
            @if (todaySchedules != null && todaySchedules.Any())
            {
                <div class="list-group">
                    @foreach (var schedule in todaySchedules.OrderBy(s => s.StartTime))
                    {
                        var cancelledToday = schedule.CancelledOn.HasValue
                            && schedule.CancelledOn.Value.Date == DateTime.UtcNow.Date;
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h6 class="mb-1">
                                        @schedule.CourseName
                                        @if (cancelledToday)
                                        {
                                            <span class="badge bg-danger ms-2">Cancelled today</span>
                                        }
                                    </h6>
                                    <p class="mb-0 text-muted">
                                        <i class="bi bi-clock me-1"></i>@schedule.StartTime - @schedule.EndTime
                                        <span class="ms-3">
                                            <i class="bi bi-door-open me-1"></i>Room @schedule.RoomNumber
                                        </span>
                                    </p>
                                    @if (cancelledToday && !string.IsNullOrEmpty(schedule.CancellationReason))
                                    {
                                        <div class="text-muted small mt-1"><em>@schedule.CancellationReason</em></div>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    @if (cancelledToday)
                                    {
                                        <button type="button" class="btn btn-outline-success btn-sm reinstate-btn" data-id="@schedule.Id">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reinstate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm cancel-today-btn" data-id="@schedule.Id" data-course="@schedule.CourseName">
                                            <i class="bi bi-x-circle me-1"></i>Suspend / End now
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No classes scheduled for today</p>
            }
        </div>
    </div>
</div>

<!-- Cancel / End Now confirm modal -->
<div class="modal fade" id="cancelClassModal" tabindex="-1" aria-labelledby="cancelClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelClassModalLabel">
                    <i class="bi bi-x-circle text-danger me-2"></i>Cancel today's class
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 rounded mb-3" style="background: #fef2f2; border:1px solid #fecaca;">
                    <div class="small text-muted mb-1">You're about to cancel</div>
                    <div class="fw-semibold" id="cancelClassName">—</div>
                </div>
                <p class="text-muted small mb-3">
                    The room will be released immediately and students will see this class isn't running today.
                    Next week's occurrence stays on the timetable.
                </p>
                <label for="cancelReasonInput" class="form-label">Reason <span class="text-muted small">(optional)</span></label>
                <textarea class="form-control" id="cancelReasonInput" rows="3" maxlength="255" placeholder="e.g. Not feeling well, travelling, conference..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep the class</button>
                <button type="button" class="btn btn-danger" id="cancelConfirmBtn">
                    <i class="bi bi-x-circle me-1"></i>Cancel for today
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        const TOKEN = '@(Model.AccessToken ?? "")';
        const API = window.location.protocol + '//' + window.location.host + '/api';
        const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + TOKEN };

        const cancelModalEl = document.getElementById('cancelClassModal');
        const cancelModal = cancelModalEl ? new bootstrap.Modal(cancelModalEl) : null;
        const cancelClassName = document.getElementById('cancelClassName');
        const cancelReasonInput = document.getElementById('cancelReasonInput');
        const cancelConfirmBtn = document.getElementById('cancelConfirmBtn');

        let pendingCancel = { id: null, triggerBtn: null };

        document.querySelectorAll('.cancel-today-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                pendingCancel = { id: btn.dataset.id, triggerBtn: btn };
                cancelClassName.textContent = btn.dataset.course || 'this class';
                cancelReasonInput.value = '';
                cancelModal?.show();
                setTimeout(() => cancelReasonInput.focus(), 300);
            });
        });

        if (cancelConfirmBtn) {
            cancelConfirmBtn.addEventListener('click', async () => {
                if (!pendingCancel.id) return;
                const id = pendingCancel.id;
                const reason = cancelReasonInput.value.trim();
                cancelConfirmBtn.disabled = true;
                cancelConfirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Cancelling…';
                try {
                    const res = await fetch(API + '/LectureSchedule/' + id + '/cancel-today', {
                        method: 'POST', headers,
                        body: JSON.stringify({ reason: reason || null })
                    });
                    if (res.ok) {
                        cancelModal?.hide();
                        if (window.Toast) Toast.success('Class cancelled for today. Room released.');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        const j = await res.json().catch(() => ({}));
                        if (window.Toast) Toast.error(j.message || 'Could not cancel the class.');
                    }
                } finally {
                    cancelConfirmBtn.disabled = false;
                    cancelConfirmBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Cancel for today';
                }
            });
        }

        document.querySelectorAll('.reinstate-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                btn.disabled = true;
                try {
                    const res = await fetch(API + '/LectureSchedule/' + id + '/reinstate-today', {
                        method: 'POST', headers
                    });
                    if (res.ok) {
                        if (window.Toast) Toast.success('Class reinstated for today.');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        const j = await res.json().catch(() => ({}));
                        if (window.Toast) Toast.error(j.message || 'Could not reinstate the class.');
                    }
                } finally {
                    btn.disabled = false;
                }
            });
        });
    })();
    </script>
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "AVAILABLE" => "bg-success",
            "IN_CLASS" => "bg-danger",
            "IN_MEETING" => "bg-warning",
            "ON_LEAVE" => "bg-secondary",
            "UNAVAILABLE" => "bg-dark",
            _ => "bg-secondary"
        };
    }

    int GetDayOrder(string day)
    {
        return day.ToUpper() switch
        {
            "MONDAY" => 1,
            "TUESDAY" => 2,
            "WEDNESDAY" => 3,
            "THURSDAY" => 4,
            "FRIDAY" => 5,
            "SATURDAY" => 6,
            "SUNDAY" => 7,
            _ => 8
        };
    }
}
