@page
@model AUCAPulse.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access denied · AUCA Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: #f7f8fa; min-height: 100vh;">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <div class="mb-3" style="font-size: 3.5rem; color: #f59e0b;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h2 class="mb-2">Access denied</h2>
                    <p class="text-muted mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.UserRole))
                        {
                            <span>Your @Model.UserRole account isn't allowed to open that page.</span>
                        }
                        else
                        {
                            <span>You need to be signed in to open that page.</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.AttemptedPath))
                    {
                        <p class="text-muted small mb-4">
                            Requested: <code>@Model.AttemptedPath</code>
                        </p>
                    }
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        @{
                            var homeFor = Model.UserRole switch
                            {
                                "STUDENT" => "/Home",
                                "STAFF"   => "/StaffDashboard",
                                "ADMIN" or "LECTURER" => "/Dashboard",
                                _ => "/Login"
                            };
                        }
                        <a href="@homeFor" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i>Back to where you belong
                        </a>
                        <a href="/Logout" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-right me-1"></i>Sign out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
