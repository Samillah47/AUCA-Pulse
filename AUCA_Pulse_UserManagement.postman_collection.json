{
	"info": {
		"name": "AUCA Pulse - User Management",
		"description": "User Management API endpoints for AUCA Pulse system",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get User by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/user/:userId",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", ":userId"],
					"variable": [
						{
							"key": "userId",
							"value": "",
							"description": "User ID (GUID)"
						}
					]
				},
				"description": "Get user details by ID. Requires authentication."
			},
			"response": []
		},
		{
			"name": "Get User by Email",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/user/email/:email",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", "email", ":email"],
					"variable": [
						{
							"key": "email",
							"value": "habiyaadolphe19@gmail.com",
							"description": "User email"
						}
					]
				},
				"description": "Get user details by email. Requires authentication."
			},
			"response": []
		},
		{
			"name": "Get All Users (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/user",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user"]
				},
				"description": "Get all users. Requires ADMIN role."
			},
			"response": []
		},
		{
			"name": "Get Users by Status (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/user/status/:status",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", "status", ":status"],
					"variable": [
						{
							"key": "status",
							"value": "PENDING",
							"description": "User status: PENDING, APPROVED, REJECTED"
						}
					]
				},
				"description": "Get users by status. Requires ADMIN role."
			},
			"response": []
		},
		{
			"name": "Get Users by Role (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/user/role/:roleId",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", "role", ":roleId"],
					"variable": [
						{
							"key": "roleId",
							"value": "",
							"description": "Role ID (GUID)"
						}
					]
				},
				"description": "Get users by role. Requires ADMIN role."
			},
			"response": []
		},
		{
			"name": "Update User Profile",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Updated Name\",\n  \"phoneNumber\": \"+250788123456\",\n  \"department\": \"Computer Science\",\n  \"locationId\": null,\n  \"officeId\": null\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/user/:userId",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", ":userId"],
					"variable": [
						{
							"key": "userId",
							"value": "",
							"description": "User ID (GUID)"
						}
					]
				},
				"description": "Update user profile. Users can update their own profile, admins can update any profile."
			},
			"response": []
		},
		{
			"name": "Update User Status (Admin)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"APPROVED\",\n  \"reason\": \"All requirements met\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/user/:userId/status",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", ":userId", "status"],
					"variable": [
						{
							"key": "userId",
							"value": "",
							"description": "User ID (GUID)"
						}
					]
				},
				"description": "Approve or reject user. Requires ADMIN role. Status values: PENDING, APPROVED, REJECTED"
			},
			"response": []
		},
		{
			"name": "Delete User (Admin)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/user/:userId",
					"host": ["{{baseUrl}}"],
					"path": ["api", "user", ":userId"],
					"variable": [
						{
							"key": "userId",
							"value": "",
							"description": "User ID (GUID)"
						}
					]
				},
				"description": "Delete user. Requires ADMIN role."
			},
			"response": []
		}
	]
}
