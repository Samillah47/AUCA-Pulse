{
	"info": {
		"name": "AUCA Pulse - Room Management",
		"description": "Room Management API endpoints with occupation tracking",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Room (Admin)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"roomNumber\": \"A101\",\n  \"roomName\": \"Computer Lab 1\",\n  \"capacity\": 40,\n  \"building\": \"Main Building\",\n  \"floor\": \"1\",\n  \"roomType\": \"LAB\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/room",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room"]
				},
				"description": "Create a new room. Requires ADMIN role. RoomType: LECTURE_HALL, LAB, MEETING_ROOM, OFFICE"
			},
			"response": []
		},
		{
			"name": "Get Room by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get All Rooms",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room"]
				}
			},
			"response": []
		},
		{
			"name": "Get Rooms by Status",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room/status/:status",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", "status", ":status"],
					"variable": [
						{
							"key": "status",
							"value": "AVAILABLE",
							"description": "AVAILABLE, OCCUPIED, MAINTENANCE"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Rooms by Type",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room/type/:type",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", "type", ":type"],
					"variable": [
						{
							"key": "type",
							"value": "LABORATORY",
							"description": "LECTURE_HALL, LAB, MEETING_ROOM, OFFICE"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Available Rooms",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room/available",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", "available"]
				}
			},
			"response": []
		},
		{
			"name": "Update Room (Admin)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"roomNumber\": \"A101\",\n  \"roomName\": \"Computer Lab 1 - Updated\",\n  \"capacity\": 45,\n  \"building\": \"Main Building\",\n  \"floor\": \"1\",\n  \"roomType\": \"LAB\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/room/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Occupy Room (Lecturer)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"occupiedUntil\": \"2024-01-15T16:00:00Z\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/room/:id/occupy",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", ":id", "occupy"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				},
				"description": "Occupy a room. Requires LECTURER or ADMIN role."
			},
			"response": []
		},
		{
			"name": "Release Room (Lecturer)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room/:id/release",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", ":id", "release"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				},
				"description": "Release a room. Requires LECTURER or ADMIN role. Only the current occupant can release."
			},
			"response": []
		},
		{
			"name": "Delete Room (Admin)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/room/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "room", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				},
				"description": "Delete room. Requires ADMIN role. Cannot delete occupied rooms."
			},
			"response": []
		}
	]
}
