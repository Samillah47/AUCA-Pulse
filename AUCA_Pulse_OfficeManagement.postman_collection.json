{
	"info": {
		"name": "AUCA Pulse - Office Management",
		"description": "Office Management API endpoints with availability tracking",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Office (Admin)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"officeName\": \"Dean's Office\",\n  \"officeNumber\": \"D101\",\n  \"building\": \"Administration Building\",\n  \"floor\": \"1\",\n  \"department\": \"Administration\",\n  \"phoneExtension\": \"1234\",\n  \"staffUserId\": 1,\n  \"availabilityStatus\": \"OPEN\",\n  \"regularOpenTime\": \"08:00:00\",\n  \"regularCloseTime\": \"17:00:00\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/office",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office"]
				},
				"description": "Create a new office. Requires ADMIN role. AvailabilityStatus: OPEN, CLOSED, BUSY, AWAY"
			},
			"response": []
		},
		{
			"name": "Get Office by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/office/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get All Offices",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/office",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office"]
				}
			},
			"response": []
		},
		{
			"name": "Get Offices by Status",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/office/status/:status",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", "status", ":status"],
					"variable": [
						{
							"key": "status",
							"value": "OPEN",
							"description": "OPEN, CLOSED, BUSY, AWAY"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Office by User ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/office/user/:userId",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", "user", ":userId"],
					"variable": [
						{
							"key": "userId",
							"value": "1"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get My Office",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/office/my-office",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", "my-office"]
				},
				"description": "Get current user's office"
			},
			"response": []
		},
		{
			"name": "Update Office (Admin)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"officeName\": \"Dean's Office - Updated\",\n  \"officeNumber\": \"D101\",\n  \"building\": \"Administration Building\",\n  \"floor\": \"1\",\n  \"department\": \"Administration\",\n  \"phoneExtension\": \"1234\",\n  \"staffUserId\": 1,\n  \"availabilityStatus\": \"BUSY\",\n  \"regularOpenTime\": \"08:00:00\",\n  \"regularCloseTime\": \"17:00:00\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/office/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Update Office Availability",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"availabilityStatus\": \"AWAY\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/office/:id/availability",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", ":id", "availability"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				},
				"description": "Update office availability. Users can update their own office, admins can update any."
			},
			"response": []
		},
		{
			"name": "Delete Office (Admin)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/office/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "office", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1"
						}
					]
				}
			},
			"response": []
		}
	]
}
