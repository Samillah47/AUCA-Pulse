*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Database
*.mdf
*.ldf
*.ndf

# SQL Server files
*.mdf
*.ldf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# Node.js (if using frontend tools)
node_modules/
npm-debug.log
yarn-error.log

# Frontend build outputs
wwwroot/dist/
wwwroot/lib/

# Rider
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Migrations (optional - uncomment if you want to ignore migrations)
# Migrations/

# appsettings with secrets
appsettings.Development.json
appsettings.*.json
!appsettings.json

# Environment variables
.env
.env.local
.env.*.local
