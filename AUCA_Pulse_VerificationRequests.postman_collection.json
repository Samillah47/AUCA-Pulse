{
	"info": {
		"name": "AUCA Pulse - Verification Requests",
		"description": "Verification Request Management API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Verification Request",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"submittedId\": \"STU12345\",\n  \"requestType\": \"STUDENT\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest"]
				},
				"description": "Create a new verification request. RequestType values: STUDENT, LECTURER, STAFF"
			},
			"response": []
		},
		{
			"name": "Get Verification Request by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1",
							"description": "Request ID"
						}
					]
				},
				"description": "Get verification request by ID. Users can only view their own requests."
			},
			"response": []
		},
		{
			"name": "Get All Verification Requests (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest"]
				},
				"description": "Get all verification requests. Requires ADMIN role."
			},
			"response": []
		},
		{
			"name": "Get My Verification Requests",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest/my-requests",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest", "my-requests"]
				},
				"description": "Get current user's verification requests."
			},
			"response": []
		},
		{
			"name": "Get Requests by User ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest/user/:userId",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest", "user", ":userId"],
					"variable": [
						{
							"key": "userId",
							"value": "",
							"description": "User ID"
						}
					]
				},
				"description": "Get verification requests by user ID. Users can only view their own requests unless admin."
			},
			"response": []
		},
		{
			"name": "Get Requests by Status (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest/status/:status",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest", "status", ":status"],
					"variable": [
						{
							"key": "status",
							"value": "PENDING",
							"description": "Status: PENDING, APPROVED, REJECTED"
						}
					]
				},
				"description": "Get verification requests by status. Requires ADMIN role."
			},
			"response": []
		},
		{
			"name": "Update Request Status (Admin)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"APPROVED\",\n  \"rejectionReason\": \"Documents verified successfully\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1",
							"description": "Request ID"
						}
					]
				},
				"description": "Update verification request status. Requires ADMIN role. Status values: PENDING, APPROVED, REJECTED"
			},
			"response": []
		},
		{
			"name": "Delete Verification Request (Admin)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/verificationrequest/:id",
					"host": ["{{baseUrl}}"],
					"path": ["api", "verificationrequest", ":id"],
					"variable": [
						{
							"key": "id",
							"value": "1",
							"description": "Request ID"
						}
					]
				},
				"description": "Delete verification request. Requires ADMIN role."
			},
			"response": []
		}
	]
}
